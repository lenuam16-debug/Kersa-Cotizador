    <div id="detail-footer"></div>
  </aside>

</div>

<!-- NEW LEAD MODAL -->
<div class="modal-overlay" id="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Nuevo Lead</span>
      <button class="detail-close" style="position:static" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-input" id="new-name" placeholder="Nombre completo o usuario">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group">
          <label class="form-label">Plataforma</label>
          <select class="form-select" id="new-platform">
            <option>Instagram</option><option>WhatsApp</option><option>Facebook</option><option>TikTok</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Vendedora</label>
          <select class="form-select" id="new-seller">
            <option>Marilyn</option><option>Jose Manuel</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Usuario / Contacto</label>
        <input type="text" class="form-input" id="new-handle" placeholder="@usuario o número">
      </div>
      <div class="form-group">
        <label class="form-label">Primer mensaje / Interés</label>
        <textarea class="form-textarea" id="new-message" placeholder="¿Qué busca este cliente?"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-ghost" onclick="closeModal()">Cancelar</button>
      <button class="btn-primary" id="create-btn" onclick="createLead()">Crear lead</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- MOBILE BOTTOM NAV -->
<nav class="mobile-nav" id="mobile-nav">
  <button class="mob-tab active" id="mob-tab-leads" onclick="mobSwitchTab('leads',this)">
    <span class="mob-icon">📋</span>
    <span>Leads</span>
    <span class="mob-badge" id="mob-badge-unread" style="display:none">0</span>
  </button>
  <button class="mob-tab" id="mob-tab-embudo" onclick="mobSwitchTab('embudo',this)">
    <span class="mob-icon">📊</span>
    <span>Embudo</span>
  </button>
  <button class="mob-tab mob-add" onclick="openNewLeadModal()">
    <span class="mob-icon">＋</span>
    <span>Nuevo</span>
  </button>
  <button class="mob-tab" id="mob-tab-settings" onclick="mobSwitchTab('settings',this)">
    <span class="mob-icon">⚙️</span>
    <span>Ajustes</span>
  </button>
</nav>

<script>
// ═══════════════════════════════════════════════════════════
// ⚙️  CONFIGURACIÓN — Pega tus claves de Supabase aquí
// ═══════════════════════════════════════════════════════════
const SUPABASE_URL      = 'https://awscrogqprosivmtgkio.supabase.co'
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF3c2Nyb2dxcHJvc2l2bXRna2lvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzMjQ1NDIsImV4cCI6MjA5NzkwMDU0Mn0.WcYei2z8UGNCTQaWKSTNeWEJByWKTNqHyyCrwcPPnTQ'
const EVOLUTION_URL      = 'https://evolution-api-production-2c596.up.railway.app'
const EVOLUTION_KEY      = '9b80ce11d4c45e83eea632626e99174a6f91425d7460b6288154165d4d224463'
const EVOLUTION_INSTANCE = 'kersa-principal'
// ═══════════════════════════════════════════════════════════

// ─── INIT SUPABASE ─────────────────────────────────────────
const IS_CONFIGURED = SUPABASE_URL !== 'TU_SUPABASE_URL'
let db = null

if (IS_CONFIGURED) {
  const { createClient } = supabase
  db = createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
}

// ─── STATE ────────────────────────────────────────────────
let leads = []
let currentUser = null
let currentSellerName = 'Jose Manuel'
let currentFilter = 'all'
let currentView = 'kanban'
let selectedLeadId = null
let activeDetailTab = 'messages'
let newLeadStage = 'nuevo'
let realtimeChannel = null

// ─── CONSTANTS ────────────────────────────────────────────
const STAGES = [
  { id:'bot',         label:'🤖 Bot Kira',        dotClass:'col-dot-bot',         statusClass:'status-bot' },
  { id:'nuevo',       label:'Nuevo lead',         dotClass:'col-dot-nuevo',       statusClass:'status-nuevo' },
  { id:'contacto',    label:'En conversación',    dotClass:'col-dot-contacto',    statusClass:'status-contacto' },
  { id:'cotizacion',  label:'Cotización enviada', dotClass:'col-dot-cotizacion',  statusClass:'status-cotizacion' },
  { id:'negociacion', label:'Negociación',        dotClass:'col-dot-negociacion', statusClass:'status-negociacion' },
  { id:'seguimiento', label:'🔔 Seguimiento',     dotClass:'col-dot-seguimiento', statusClass:'status-seguimiento' },
  { id:'ganado',      label:'Cerrado / Ganado',   dotClass:'col-dot-ganado',      statusClass:'status-ganado' },
  { id:'perdido',     label:'Perdido',            dotClass:'col-dot-perdido',     statusClass:'status-perdido' },
]
let SELLERS = [
  { name:'Marilyn',     color:'#0EA5E9', role:'vendedora' },
  { name:'Jose Manuel', color:'#7C3AED', role:'admin' },
]
const AV_CLASSES = ['av-1','av-2','av-3','av-4','av-5','av-6']

// ─── HELPERS ──────────────────────────────────────────────
function timeAgo(iso) {
  if (!iso) return ''
  const diff = Math.floor((Date.now() - new Date(iso)) / 1000)
  if (diff < 60)     return 'ahora mismo'
  if (diff < 3600)   return `hace ${Math.floor(diff/60)} min`
  if (diff < 86400)  return `hace ${Math.floor(diff/3600)}h`
  if (diff < 172800) return 'ayer'
  return `hace ${Math.floor(diff/86400)} días`
}

function formatTime(iso) {
  if (!iso) return ''
  const d = new Date(iso)
  const h = d.getHours(), m = String(d.getMinutes()).padStart(2,'0')
  return `${h}:${m}`
}

function formatDate(iso) {
  if (!iso) return ''
  const d = new Date(iso), now = new Date()
  const diff = Math.floor((now - d) / 86400000)
  if (diff === 0) return 'Hoy'
  if (diff === 1) return 'Ayer'
  return d.toLocaleDateString('es-VE', { day:'numeric', month:'short' })
}

function normalizeLeads(data) {
  return data.map(lead => ({
    ...lead,
    messages: (lead.messages || [])
      .sort((a,b) => new Date(a.created_at) - new Date(b.created_at))
      .map(m => ({ ...m, from: m.from_type, time: formatTime(m.created_at) })),
    notes: (lead.notes || [])
      .sort((a,b) => new Date(b.created_at) - new Date(a.created_at))
      .map(n => ({ ...n, date: formatDate(n.created_at) })),
    time: timeAgo(lead.updated_at || lead.created_at)
  }))
}

function avClass(id) {
  // Derive consistent color from id string
  const sum = (id||'').split('').reduce((a,c) => a + c.charCodeAt(0), 0)
  return AV_CLASSES[sum % AV_CLASSES.length]
}
function initials(name) { return (name||'?').split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase() }

function platBadge(platform) {
  const icons = { Instagram:'📸', WhatsApp:'💬', Facebook:'👤', TikTok:'🎵' }
  const classes = { Instagram:'plat-ig', WhatsApp:'plat-wa', Facebook:'plat-fb', TikTok:'plat-tt' }
  return `<span class="platform-badge ${classes[platform]||'plat-ig'}">${icons[platform]||'📱'} ${platform}</span>`
}
function platDot(platform) {
  const cls = { Instagram:'dot-ig', WhatsApp:'dot-wa', Facebook:'dot-fb', TikTok:'dot-tt' }
  return `<div class="platform-dot ${cls[platform]||'dot-ig'}"></div>`
}
function stageInfo(id) { return STAGES.find(s=>s.id===id)||STAGES[0] }
function sellerInfo(name) { return SELLERS.find(s=>s.name===name)||SELLERS[0] }

// ─── HELPERS ───────────────────────────────────────────────
function hide(id) { const el = document.getElementById(id); if (el) el.classList.add('hidden') }
function show(id) { const el = document.getElementById(id); if (el) el.classList.remove('hidden') }

// ─── AUTH ─────────────────────────────────────────────────
async function init() {
  if (!IS_CONFIGURED) {
    hide('loading-overlay')
    document.getElementById('config-overlay').classList.add('show')
    return
  }

  const { data: { session } } = await db.auth.getSession()
  if (session) {
    await onLogin(session.user)
  } else {
    hide('loading-overlay')
    show('login-overlay')
    setTimeout(() => document.getElementById('login-email').focus(), 100)
  }
}

async function onLogin(user) {
  currentUser = user
  // Mapeo de emails a nombres de seller
  const emailToName = { 'lenuam16@gmail.com': 'Jose Manuel', 'jpablos.kersa@gmail.com': 'Jose Manuel' }
  currentSellerName = emailToName[user.email] || user.user_metadata?.name || user.email.split('@')[0]
  const init = currentSellerName.split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase()
  document.getElementById('user-avatar').textContent = init
  document.getElementById('user-name').textContent = currentSellerName
  hide('login-overlay')
  show('loading-overlay')
  loadAssignRules()
  await Promise.all([fetchLeads(), loadCrmUsers()])
  hide('loading-overlay')
  subscribeToChanges()
}

async function doLogin() {
  const email = document.getElementById('login-email').value.trim()
  const password = document.getElementById('login-password').value
  const errEl = document.getElementById('login-error')
  const spinEl = document.getElementById('login-spinner')
  const btnEl = document.getElementById('login-btn')

  if (!email || !password) { showLoginError('Completa todos los campos'); return }

  errEl.style.display = 'none'
  spinEl.style.display = 'block'
  btnEl.disabled = true

  const { data, error } = await db.auth.signInWithPassword({ email, password })

  spinEl.style.display = 'none'
  btnEl.disabled = false

  if (error) {
    showLoginError('Correo o contraseña incorrectos')
    return
  }
  await onLogin(data.user)
}

async function doLogout() {
  if (!confirm('¿Cerrar sesión?')) return
  if (realtimeChannel) db.removeChannel(realtimeChannel)
  await db.auth.signOut()
  location.reload()
}

function showLoginError(msg) {
  const el = document.getElementById('login-error')
  el.textContent = msg
  el.style.display = 'block'
}

// ─── DATA — FETCH ──────────────────────────────────────────
async function fetchLeads() {
  const { data, error } = await db
    .from('leads')
    .select(`*, messages(id,from_type,text,media_url,media_type,media_name,created_at), notes(id,author,text,created_at)`)
    .order('updated_at', { ascending: false })

  if (error) { showToast('⚠️ Error al cargar leads'); console.error(error); return }
  leads = normalizeLeads(data)
  renderAll()
  updateBadges()
  updateStats()
}

// ─── DATA — CRUD ───────────────────────────────────────────
async function createLead() {
  const name = document.getElementById('new-name').value.trim()
  if (!name) { showToast('⚠️ Ingresa un nombre'); return }

  const platform = document.getElementById('new-platform').value
  const seller   = document.getElementById('new-seller').value
  const handle   = document.getElementById('new-handle').value.trim() || ''
  const message  = document.getElementById('new-message').value.trim()

  const btn = document.getElementById('create-btn')
  btn.disabled = true; btn.textContent = 'Guardando...'

  const { data: leadData, error } = await db
    .from('leads')
    .insert({ name, handle, platform, seller, stage: newLeadStage, unread: false })
    .select()
    .single()

  if (error) { showToast('⚠️ Error al crear lead'); btn.disabled=false; btn.textContent='Crear lead'; return }

  if (message) {
    await db.from('messages').insert({ lead_id: leadData.id, from_type: 'lead', text: message })
  }

  btn.disabled = false; btn.textContent = 'Crear lead'
  closeModal()
  showToast(`✅ Lead "${name}" creado`)
  await fetchLeads()
  selectLead(leadData.id)
}

async function sendMessage(leadId) {
  const input = document.getElementById('msg-input')
  const text = input.value.trim()
  if (!text) return
  input.value = ''

  // ── Optimistic update: mostrar mensaje inmediatamente ──
  const lead = leads.find(l => l.id === leadId)
  const now = new Date().toISOString()
  const tempId = 'temp_' + Date.now()
  if (lead) {
    lead.messages.push({ id: tempId, from_type: 'team', text, created_at: now })
    renderDetailBody()
    const body = document.getElementById('detail-body')
    if (body) body.scrollTop = body.scrollHeight
  }

  // Guardar en Supabase
  const { data: msgData, error } = await db.from('messages')
    .insert({ lead_id: leadId, from_type: 'team', text })
    .select().single()
  if (error) { showToast('⚠️ Error al enviar mensaje'); return }

  // Reemplazar mensaje temporal con el real
  if (lead && msgData) {
    const idx = lead.messages.findIndex(m => m.id === tempId)
    if (idx >= 0) lead.messages[idx] = msgData
  }

  // Actualizar updated_at sin esperar
  db.from('leads').update({ updated_at: now, unread: false }).eq('id', leadId)

  if (lead && lead.platform === 'Instagram' && lead.handle) {
    try {
      const res = await fetch('https://awscrogqprosivmtgkio.supabase.co/functions/v1/smooth-api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'reply', recipient_id: lead.handle, message_text: text })
      })
      if (res.ok) showToast('✅ Mensaje enviado por Instagram')
      else showToast('⚠️ Guardado en CRM, pero no se envió por Instagram')
    } catch (e) {
      showToast('💬 Guardado en CRM')
    }
  }

  if (lead && lead.platform === 'Facebook' && lead.handle) {
    try {
      const res = await fetch('https://awscrogqprosivmtgkio.supabase.co/functions/v1/smooth-api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'reply_facebook', recipient_id: lead.handle, message_text: text })
      })
      if (res.ok) showToast('✅ Mensaje enviado por Facebook')
      else showToast('⚠️ Guardado en CRM, pero no se envió por Facebook')
    } catch (e) {
      showToast('💬 Guardado en CRM')
    }
  }

  if (lead && lead.platform === 'WhatsApp' && lead.handle) {
    try {
      const phone = lead.handle.replace(/\D/g, '')
      const res = await fetch(`${EVOLUTION_URL}/message/sendText/${EVOLUTION_INSTANCE}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': EVOLUTION_KEY },
        body: JSON.stringify({ number: phone, text })
      })
      if (res.ok) showToast('✅ Mensaje enviado por WhatsApp')
      else showToast('⚠️ Guardado en CRM, pero no se envió por WhatsApp')
    } catch (e) {
      showToast('💬 Guardado en CRM')
    }
  }

}

async function addNote(leadId) {
  const input = document.getElementById('note-input')
  const text = input.value.trim()
  if (!text) return
  input.value = ''

  const { error } = await db.from('notes').insert({ lead_id: leadId, author: currentSellerName, text })
  if (error) { showToast('⚠️ Error al guardar nota'); return }

  await db.from('leads').update({ updated_at: new Date().toISOString() }).eq('id', leadId)
  showToast('📝 Nota guardada')
  await fetchLeads()
  renderDetail(leads.find(l=>l.id===leadId))
}

async function changeStage(leadId, newStage) {
  await db.from('leads').update({ stage: newStage, updated_at: new Date().toISOString() }).eq('id', leadId)
  const stage = stageInfo(newStage)
  showToast(`📌 Movido a "${stage.label}"`)
  await fetchLeads()
  renderDetail(leads.find(l=>l.id===leadId))
}

async function changeSeller(leadId, newSeller) {
  await db.from('leads').update({ seller: newSeller, updated_at: new Date().toISOString() }).eq('id', leadId)
  showToast(`👤 Asignado a ${newSeller}`)
  await fetchLeads()
}

async function markRead(leadId) {
  await db.from('leads').update({ unread: false }).eq('id', leadId)
}

// ─── REAL-TIME ─────────────────────────────────────────────
function subscribeToChanges() {
  realtimeChannel = db.channel('crm-kersa-live')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'leads' }, () => fetchLeads())
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages' }, handleIncomingMessage)
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'messages' }, () => fetchLeads())
    .on('postgres_changes', { event: '*', schema: 'public', table: 'notes' }, () => fetchLeads())
    .subscribe()

  // Pedir permiso para notificaciones del navegador
  if ('Notification' in window && Notification.permission === 'default') {
    Notification.requestPermission()
  }
}

async function handleIncomingMessage(payload) {
  const msg = payload.new
  if (!msg) return

  // Si es mensaje nuestro (de otro dispositivo), solo refrescar
  if (msg.from_type === 'team') {
    await fetchLeads()
    return
  }

  // Mensaje del cliente — actualizar localmente sin refetch total
  let lead = leads.find(l => l.id === msg.lead_id)
  if (!lead) {
    await fetchLeads()
    return
  }

  // Agregar mensaje si no existe ya
  if (!lead.messages.find(m => m.id === msg.id)) {
    lead.messages.push(msg)
    lead.unread = true
    lead.updated_at = msg.created_at || new Date().toISOString()
  }

  // Reordenar leads por actividad
  leads.sort((a, b) => new Date(b.updated_at || 0) - new Date(a.updated_at || 0))

  // Si el chat de este lead está abierto, agregar mensaje en tiempo real
  if (selectedLeadId === msg.lead_id) {
    renderDetailBody()
    const body = document.getElementById('detail-body')
    if (body) setTimeout(() => { body.scrollTop = body.scrollHeight }, 50)
  }

  renderList()
  renderKanban()
  updateBadges()

  // Notificación
  notifyNewMessage(lead, msg)
}

function notifyNewMessage(lead, msg) {
  const unreadCount = leads.filter(l => l.unread).length
  document.title = unreadCount > 0 ? `(${unreadCount}) Kersa CRM` : 'Kersa CRM'

  // Solo notificar si el lead NO está abierto
  if (selectedLeadId === lead.id) return

  showNotifToast(lead, msg)

  // Notificación del navegador
  if ('Notification' in window && Notification.permission === 'granted') {
    try {
      new Notification(`💬 ${lead.name}`, {
        body: msg.text?.substring(0, 100) || 'Nuevo mensaje',
        icon: '/icon.svg',
        tag: lead.id
      })
    } catch(e) {}
  }
}

function showNotifToast(lead, msg) {
  const existing = document.getElementById('notif-toast')
  if (existing) existing.remove()
  const div = document.createElement('div')
  div.id = 'notif-toast'
  div.style.cssText = `position:fixed;top:16px;right:16px;z-index:10000;background:#202c33;color:#e9edef;border-radius:12px;padding:12px 16px;max-width:300px;cursor:pointer;box-shadow:0 4px 24px rgba(0,0,0,0.6);border-left:4px solid #00a884;font-family:Barlow,sans-serif;animation:notifSlideIn 0.3s ease`
  div.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">
      <div style="min-width:0">
        <div style="font-size:10px;color:#8696a0;margin-bottom:3px">${platIcon(lead.platform)} ${lead.platform} · Mensaje nuevo</div>
        <div style="font-size:13px;font-weight:600;margin-bottom:2px">${lead.name}</div>
        <div style="font-size:12px;color:#aebac1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${msg.text||''}</div>
      </div>
      <button onclick="event.stopPropagation();document.getElementById('notif-toast')?.remove()" style="background:none;border:none;color:#8696a0;font-size:16px;cursor:pointer;flex-shrink:0;line-height:1">×</button>
    </div>`
  div.onclick = () => { div.remove(); selectLead(lead.id) }
  document.body.appendChild(div)
  setTimeout(() => { if (div.parentNode) div.remove() }, 7000)
}

// ─── DRAG & DROP (desktop) ─────────────────────────────────
let draggedId = null
function dragStart(e, id) { draggedId = id; e.dataTransfer.effectAllowed = 'move' }
function allowDrop(e) { e.preventDefault() }
async function dropLead(e, stageId) {
  e.preventDefault()
  if (!draggedId) return
  const lead = leads.find(l=>l.id===draggedId)
  if (lead && lead.stage !== stageId) await changeStage(draggedId, stageId)
  draggedId = null
}

// ─── TOUCH DRAG & DROP (mobile) ────────────────────────────
const _td = { id: null, el: null, clone: null, stage: null, timer: null, active: false, sx: 0, sy: 0 }

function tdStart(e, id) {
  const touch = e.touches[0]
  _td.sx = touch.clientX; _td.sy = touch.clientY
  _td.id = id; _td.el = e.currentTarget; _td.active = false
  _td.timer = setTimeout(() => {
    _td.active = true
    navigator.vibrate && navigator.vibrate(40)
    // Build floating clone
    const rect = _td.el.getBoundingClientRect()
    const clone = _td.el.cloneNode(true)
    clone.className = 'lead-card touch-drag-clone'
    clone.style.width = rect.width + 'px'
    clone.style.top = rect.top + 'px'
    clone.style.left = rect.left + 'px'
    clone._ox = touch.clientX - rect.left
    clone._oy = touch.clientY - rect.top
    document.body.appendChild(clone)
    _td.clone = clone
    _td.el.classList.add('touch-dragging')
  }, 350)
}

document.addEventListener('touchmove', e => {
  // Cancel timer if user scrolled before drag activated
  if (!_td.active && _td.timer) {
    const dx = Math.abs(e.touches[0].clientX - _td.sx)
    const dy = Math.abs(e.touches[0].clientY - _td.sy)
    if (dx > 8 || dy > 8) { clearTimeout(_td.timer); _td.timer = null; _td.id = null }
    return
  }
  if (!_td.active || !_td.clone) return
  e.preventDefault()
  const t = e.touches[0]
  _td.clone.style.left = (t.clientX - _td.clone._ox) + 'px'
  _td.clone.style.top  = (t.clientY - _td.clone._oy) + 'px'
  // Detect column under finger
  _td.clone.style.visibility = 'hidden'
  const under = document.elementFromPoint(t.clientX, t.clientY)
  _td.clone.style.visibility = ''
  document.querySelectorAll('.col-body').forEach(c => c.classList.remove('drag-over'))
  const col = under?.closest('.col-body')
  if (col) { col.classList.add('drag-over'); _td.stage = col.id.replace('col-', '') }
  else _td.stage = null
}, { passive: false })

document.addEventListener('touchend', async () => {
  clearTimeout(_td.timer); _td.timer = null
  if (!_td.active) { _td.id = null; return }
  _td.active = false
  if (_td.clone) { _td.clone.remove(); _td.clone = null }
  if (_td.el) { _td.el.classList.remove('touch-dragging'); _td.el = null }
  document.querySelectorAll('.col-body').forEach(c => c.classList.remove('drag-over'))
  if (_td.stage && _td.id) {
    const lead = leads.find(l => l.id === _td.id)
    if (lead && lead.stage !== _td.stage) await changeStage(_td.id, _td.stage)
  }
  _td.id = null; _td.stage = null
})

document.addEventListener('touchcancel', () => {
  clearTimeout(_td.timer); _td.timer = null; _td.active = false
  if (_td.clone) { _td.clone.remove(); _td.clone = null }
  if (_td.el) { _td.el.classList.remove('touch-dragging'); _td.el = null }
  document.querySelectorAll('.col-body').forEach(c => c.classList.remove('drag-over'))
  _td.id = null; _td.stage = null
})

// ─── FILTER ────────────────────────────────────────────────
function getFilteredLeads() {
  let filtered = [...leads]
  const search = document.getElementById('search-input').value.toLowerCase()

  if (currentFilter === 'unread') filtered = filtered.filter(l => l.unread)
  else if (currentFilter === 'mine') filtered = filtered.filter(l => l.seller === currentSellerName)
  else if (currentFilter.startsWith('seller-')) {
    const s = currentFilter.replace('seller-','')
    filtered = filtered.filter(l => l.seller === s)
  } else if (['Instagram','WhatsApp','Facebook','TikTok'].includes(currentFilter)) {
    filtered = filtered.filter(l => l.platform === currentFilter)
  }

  if (search) {
    filtered = filtered.filter(l =>
      l.name.toLowerCase().includes(search) ||
      (l.handle||'').toLowerCase().includes(search) ||
      l.messages.some(m => m.text.toLowerCase().includes(search))
    )
  }
  return filtered
}

function filterBy(key, el) {
  currentFilter = key
  document.querySelectorAll('.sidebar-item').forEach(e => e.classList.remove('active'))
  if (el) el.classList.add('active')
  renderAll()
}
function filterSearch() { renderAll() }

// ─── RENDER KANBAN ─────────────────────────────────────────
function renderKanban() {
  const wrap = document.getElementById('kanban-view')
  const filtered = getFilteredLeads()
  wrap.innerHTML = ''

  STAGES.forEach(stage => {
    const stageLeads = filtered.filter(l => l.stage === stage.id)
    const col = document.createElement('div')
    col.className = 'kanban-col'
    col.innerHTML = `
      <div class="col-header">
        <div class="col-dot ${stage.dotClass}"></div>
        <div class="col-title">${stage.label}</div>
        <div class="col-count">${stageLeads.length}</div>
      </div>
      <div class="col-body" id="col-${stage.id}" ondragover="allowDrop(event)" ondrop="dropLead(event,'${stage.id}')">
        ${stageLeads.length===0 ? '<div class="empty-col">Sin leads</div>' : ''}
        ${stageLeads.map(l => renderCard(l)).join('')}
        <button class="add-card-btn" onclick="openNewLeadModalInStage('${stage.id}')">+ Agregar lead</button>
      </div>
    `
    wrap.appendChild(col)
  })

  updateCount(filtered.length)
}

function renderCard(lead) {
  const av = avClass(lead.id)
  const init = initials(lead.name)
  const seller = sellerInfo(lead.seller)
  const lastMsg = lead.messages[lead.messages.length-1]
  const canDelete = isCurrentUserAdmin()
  return `
    <div class="lead-card ${selectedLeadId===lead.id?'selected':''}"
         style="position:relative"
         onclick="selectLead('${lead.id}')"
         draggable="true"
         ondragstart="dragStart(event,'${lead.id}')"
         ontouchstart="tdStart(event,'${lead.id}')">
      ${lead.unread ? '<div class="unread-dot"></div>' : ''}
      ${canDelete ? `<button class="card-del-btn" onclick="event.stopPropagation();deleteLead('${lead.id}','${(lead.name||'').replace(/'/g,"\\'")}')" title="Eliminar lead">✕</button>` : ''}
      <div class="lead-card-top">
        <div class="lead-avatar ${av}">${init}</div>
        <div class="lead-info">
          <div class="lead-name">${lead.name}${lead.stage==='bot'?' <span style="font-size:10px;background:rgba(167,139,250,0.2);color:#A78BFA;border-radius:4px;padding:1px 5px;font-weight:600;vertical-align:middle">🤖 Kira</span>':lead.stage==='seguimiento'?' <span style="font-size:10px;background:rgba(251,146,60,0.2);color:#FB923C;border-radius:4px;padding:1px 5px;font-weight:600;vertical-align:middle">🔔</span>':''}</div>
          <div class="lead-handle">${lead.handle||''}</div>
        </div>
        ${platDot(lead.platform)}
      </div>
      <div class="lead-preview">${lastMsg ? lastMsg.text : 'Sin mensajes'}</div>
      <div class="lead-card-footer">
        <span class="lead-time">${lead.time}</span>
        <span class="lead-seller" onclick="event.stopPropagation()" title="Reasignar lead">
          <div class="seller-dot" style="background:${seller.color||'#888'};width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;font-family:Montserrat,sans-serif;color:#ffffff;flex-shrink:0">${(seller.name||'?')[0].toUpperCase()}</div>
          <select onchange="changeSeller('${lead.id}',this.value)" style="font-size:11px;border:none;background:transparent;color:var(--text);cursor:pointer;max-width:72px;padding:0;outline:none">
            ${SELLERS.map(s=>`<option value="${s.name}"${s.name===lead.seller?' selected':''}>${s.name}</option>`).join('')}
          </select>
        </span>
      </div>
    </div>
  `
}

// ─── RENDER LIST ───────────────────────────────────────────
function renderList() {
  const filtered = getFilteredLeads()
  const stageOrder = STAGES.map(s=>s.id)
  document.getElementById('list-tbody').innerHTML = filtered.map(lead => {
    const av = avClass(lead.id)
    const init = initials(lead.name)
    const stage = stageInfo(lead.stage)
    const seller = sellerInfo(lead.seller)
    const stageIdx = stageOrder.indexOf(lead.stage)
    const isPerdido = lead.stage==='perdido'
    const filledCount = isPerdido ? 0 : stageIdx+1
    const bars = STAGES.slice(0,5).map((_,i) => `<div class="pipeline-seg ${i<filledCount?'filled':''}"></div>`).join('')
    return `
      <tr onclick="selectLead('${lead.id}')" class="${selectedLeadId===lead.id?'selected':''}">
        <td>
          <div style="display:flex;align-items:center;gap:10px">
            <div class="lead-avatar ${av}" style="width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;font-family:Montserrat,sans-serif;color:#ffffff;flex-shrink:0;">${init}</div>
            <div>
              <div class="td-name">${lead.name} ${lead.unread?'<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--blue);margin-left:4px;vertical-align:middle;"></span>':''}</div>
              <div class="td-sub">${lead.handle||''}</div>
            </div>
          </div>
        </td>
        <td>${platBadge(lead.platform)}</td>
        <td><span class="status-pill ${stage.statusClass}"><span style="width:6px;height:6px;border-radius:50%;background:currentColor;opacity:0.7;"></span>${stage.label}</span></td>
        <td onclick="event.stopPropagation()" title="Reasignar lead">
          <div style="display:flex;align-items:center;gap:7px">
            <div class="seller-dot" style="background:${seller.color||'#888'};width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:Montserrat,sans-serif;color:#ffffff;flex-shrink:0">${(seller.name||'?')[0].toUpperCase()}</div>
            <select onchange="changeSeller('${lead.id}',this.value)" style="font-size:13px;border:none;background:transparent;color:var(--text);cursor:pointer;padding:0;outline:none">
              ${SELLERS.map(s=>`<option value="${s.name}"${s.name===lead.seller?' selected':''}>${s.name}</option>`).join('')}
            </select>
          </div>
        </td>
        <td style="color:var(--text-muted)">${lead.time}</td>
        <td><div class="pipeline-micro">${bars}</div></td>
      </tr>
    `
  }).join('')
  updateCount(filtered.length)
}

function updateCount(n) {
  document.getElementById('lead-count').textContent = `${n} lead${n!==1?'s':''}`
}

// ─── RENDER ALL ────────────────────────────────────────────
function renderAll() {
  renderKanban()
  renderList()
  syncMobBadge()
  if (selectedLeadId) {
    const lead = leads.find(l=>l.id===selectedLeadId)
    if (lead) renderDetail(lead)
    else closeDetail()
  }
}

// ─── VIEW SWITCH ───────────────────────────────────────────
function switchView(view, navEl) {
  currentView = view
  const isMob = window.innerWidth <= 768
  const effectiveView = view
  document.getElementById('kanban-view').style.display    = effectiveView==='kanban'   ? 'flex'   : 'none'
  document.getElementById('list-view').style.display      = effectiveView==='list'     ? 'block'  : 'none'

  const _sv = document.getElementById('settings-view')
  const _mv = document.getElementById('metrics-view')
  const _th = document.querySelector('.toolbar')?.offsetHeight || 52
  const extraBottom = isMob ? 60 : 0
  const overlayStyle = `display:block;position:absolute;top:${_th}px;left:0;right:0;bottom:${extraBottom}px;overflow-y:auto;padding:${isMob?'16px 12px':'32px'};box-sizing:border-box;background:var(--bg);z-index:5`

  if (effectiveView === 'settings') {
    _sv.style.cssText = overlayStyle
  } else {
    _sv.style.cssText = 'display:none'
  }
  if (effectiveView === 'metrics') {
    _mv.style.cssText = overlayStyle
    loadMetrics()
  } else {
    _mv.style.cssText = 'display:none'
  }

  document.getElementById('view-kanban-btn').classList.toggle('active', effectiveView==='kanban')
  document.getElementById('view-list-btn').classList.toggle('active',   effectiveView==='list')
  if (navEl) {
    document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'))
    navEl.classList.add('active')
  }
  if (effectiveView === 'settings') { loadWaStatus(); loadCrmUsers(); renderAssignSection() }
  else if (effectiveView !== 'metrics') renderAll()
}

// ─── MÉTRICAS ───────────────────────────────────────────────
async function loadMetrics() {
  const mv = document.getElementById('metrics-view')
  mv.innerHTML = `<div style="max-width:900px;margin:0 auto"><p style="color:var(--text-dim);font-size:13px">Cargando...</p></div>`

  try {
    const admin = isAdmin()
    const now   = new Date()
    const startMonth = new Date(now.getFullYear(), now.getMonth(), 1).toISOString()
    const startWeek  = new Date(now.getTime() - 7*24*3600*1000).toISOString()

    // Cargar leads según rol
    let query = _sb.from('leads').select('id,stage,platform,seller,created_at,bot_last_topic')
    if (!admin) query = query.eq('seller', currentSellerName)
    const { data: allLeads } = await query

    const leads      = allLeads ?? []
    const thisMonth  = leads.filter(l => l.created_at >= startMonth)
    const thisWeek   = leads.filter(l => l.created_at >= startWeek)
    const ganados    = leads.filter(l => l.stage === 'ganado').length
    const perdidos   = leads.filter(l => l.stage === 'perdido').length
    const activos    = leads.filter(l => !['ganado','perdido'].includes(l.stage)).length
    const convRate   = leads.length ? Math.round(ganados/leads.length*100) : 0

    const STAGE_LABELS = {
      bot:'🤖 Bot Kira', nuevo:'🆕 Nuevo', contacto:'📞 Contacto',
      cotizacion:'💰 Cotización', negociacion:'🤝 Negociación',
      seguimiento:'🔔 Seguimiento', ganado:'✅ Ganado', perdido:'❌ Perdido',
    }

    const card = (title, val, sub='', color='var(--blue-light)') =>
      `<div style="background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:16px 18px;flex:1;min-width:110px">
        <div style="font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:4px">${title}</div>
        <div style="font-size:26px;font-weight:700;color:${color};font-family:Montserrat,sans-serif;line-height:1.1">${val}</div>
        ${sub?`<div style="font-size:11px;color:var(--text-dim);margin-top:3px">${sub}</div>`:''}
      </div>`

    const bar = (label, cnt, total, color='var(--blue)') => {
      const pct = total ? Math.round(cnt/total*100) : 0
      return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:9px">
        <span style="width:120px;font-size:12px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${label}</span>
        <div style="flex:1;height:7px;background:var(--surface3);border-radius:4px;overflow:hidden">
          <div style="height:100%;width:${pct}%;background:${color};border-radius:4px"></div>
        </div>
        <span style="width:24px;text-align:right;font-size:12px;font-weight:600;color:var(--text)">${cnt}</span>
      </div>`
    }

    // ── VISTA VENDEDOR ───────────────────────────────────────
    if (!admin) {
      const byStage = {}
      for (const l of leads) byStage[l.stage] = (byStage[l.stage]||0)+1

      mv.innerHTML = `<div style="max-width:600px;margin:0 auto">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
          <h2 style="font-family:Montserrat,sans-serif;font-size:17px;font-weight:700;color:var(--text);margin:0">📊 Mi rendimiento</h2>
          <button onclick="loadMetrics()" style="background:var(--surface2);border:1px solid var(--border);color:var(--text-dim);padding:5px 12px;border-radius:8px;cursor:pointer;font-size:12px">🔄 Refrescar</button>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px">
          ${card('Mis leads', leads.length, 'total')}
          ${card('Esta semana', thisWeek.length, 'últimos 7 días','#a78bfa')}
          ${card('Este mes', thisMonth.length, now.toLocaleString('es-VE',{month:'long'}))}
          ${card('Ganados', ganados, `${convRate}% conversión`,'#34d399')}
        </div>

        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:14px">Mis leads por etapa</div>
          ${Object.entries(STAGE_LABELS).map(([s,lbl])=>bar(lbl,byStage[s]||0,leads.length,s==='ganado'?'#34d399':s==='perdido'?'#f87171':'var(--blue)')).join('')}
        </div>

        <div style="text-align:right;font-size:11px;color:var(--text-dim);margin-top:12px">
          Actualizado: ${now.toLocaleString('es-VE')}
        </div>
      </div>`
      return
    }

    // ── VISTA ADMIN (Jose Manuel) ────────────────────────────
    const byStage = {}
    const byPlat  = {}
    for (const l of leads) {
      byStage[l.stage]    = (byStage[l.stage]||0)+1
      byPlat[l.platform]  = (byPlat[l.platform]||0)+1
    }

    // Bot stats
    const botAnswered  = leads.filter(l => l.bot_last_topic).length
    const botEscalated = leads.filter(l => !l.bot_last_topic && l.platform==='WhatsApp').length
    const botTotal     = botAnswered + botEscalated
    const botRate      = botTotal ? Math.round(botAnswered/botTotal*100) : 0

    const { data: pendingFU } = await _sb.from('leads').select('id')
      .eq('stage','bot').eq('bot_followup_sent',false).not('bot_followup_at','is',null)
    const pendingCount = pendingFU?.length ?? 0

    // Por vendedor
    const bySeller = {}
    for (const l of leads) {
      const s = l.seller || 'Sin asignar'
      if (!bySeller[s]) bySeller[s] = { total:0, ganado:0, activo:0 }
      bySeller[s].total++
      if (l.stage==='ganado') bySeller[s].ganado++
      if (!['ganado','perdido'].includes(l.stage)) bySeller[s].activo++
    }

    const sellerRows = Object.entries(bySeller).map(([s, d]) => {
      const conv = d.total ? Math.round(d.ganado/d.total*100) : 0
      const sel  = SELLERS.find(x=>x.name===s)
      const dot  = sel ? `<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${sel.color};margin-right:6px"></span>` : ''
      return `<tr>
        <td style="padding:8px 6px;font-size:13px;color:var(--text)">${dot}${s}</td>
        <td style="padding:8px 6px;font-size:13px;text-align:center;color:var(--text)">${d.total}</td>
        <td style="padding:8px 6px;font-size:13px;text-align:center;color:#34d399;font-weight:600">${d.ganado}</td>
        <td style="padding:8px 6px;font-size:13px;text-align:center;color:var(--blue-light)">${d.activo}</td>
        <td style="padding:8px 6px;font-size:13px;text-align:center;color:var(--text-dim)">${conv}%</td>
      </tr>`
    }).join('')

    const platRows = Object.entries(byPlat).map(([p,c]) =>
      `<div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border)">
        <span style="font-size:13px;color:var(--text)">${p}</span>
        <span style="font-size:13px;font-weight:600;color:var(--blue-light)">${c}</span>
      </div>`).join('')

    mv.innerHTML = `<div style="max-width:900px;margin:0 auto">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
        <h2 style="font-family:Montserrat,sans-serif;font-size:17px;font-weight:700;color:var(--text);margin:0">📊 Reportes generales</h2>
        <button onclick="loadMetrics()" style="background:var(--surface2);border:1px solid var(--border);color:var(--text-dim);padding:5px 12px;border-radius:8px;cursor:pointer;font-size:12px">🔄 Refrescar</button>
      </div>

      <!-- Cards -->
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px">
        ${card('Total leads', leads.length, 'histórico')}
        ${card('Esta semana', thisWeek.length, '7 días','#a78bfa')}
        ${card('Este mes', thisMonth.length, now.toLocaleString('es-VE',{month:'long'}))}
        ${card('En curso', activos, 'activos','#fbbf24')}
        ${card('Ganados', ganados, `${convRate}% conv.`,'#34d399')}
        ${card('Perdidos', perdidos, '','#f87171')}
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">

        <!-- Funnel -->
        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:14px">Leads por etapa</div>
          ${Object.entries(STAGE_LABELS).map(([s,lbl])=>bar(lbl,byStage[s]||0,leads.length,s==='ganado'?'#34d399':s==='perdido'?'#f87171':'var(--blue)')).join('')}
        </div>

        <!-- Bot + Plataforma -->
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:18px">
            <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:12px">🤖 Kira Bot</div>
            <div style="display:flex;justify-content:space-between;margin-bottom:7px">
              <span style="font-size:13px;color:var(--text)">Respondió Kira</span>
              <span style="font-size:13px;font-weight:600;color:#34d399">${botAnswered}</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:7px">
              <span style="font-size:13px;color:var(--text)">Escalados</span>
              <span style="font-size:13px;font-weight:600;color:#fbbf24">${botEscalated}</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:12px">
              <span style="font-size:13px;color:var(--text)">Follow-ups pendientes</span>
              <span style="font-size:13px;font-weight:600;color:#a78bfa">${pendingCount}</span>
            </div>
            <div style="height:7px;background:var(--surface3);border-radius:4px;overflow:hidden">
              <div style="height:100%;width:${botRate}%;background:#34d399;border-radius:4px"></div>
            </div>
            <div style="font-size:11px;color:var(--text-dim);margin-top:5px">${botRate}% resueltos por Kira</div>
          </div>
          <div style="background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:18px">
            <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:10px">Por plataforma</div>
            ${platRows||'<span style="font-size:13px;color:var(--text-dim)">Sin datos</span>'}
          </div>
        </div>
      </div>

      <!-- Tabla por vendedor -->
      <div style="background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:12px">
        <div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:14px">Rendimiento por vendedor</div>
        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr style="border-bottom:1px solid var(--border)">
              <th style="padding:6px;text-align:left;font-size:11px;color:var(--text-dim);font-weight:600">Vendedor</th>
              <th style="padding:6px;text-align:center;font-size:11px;color:var(--text-dim);font-weight:600">Total</th>
              <th style="padding:6px;text-align:center;font-size:11px;color:var(--text-dim);font-weight:600">Ganados</th>
              <th style="padding:6px;text-align:center;font-size:11px;color:var(--text-dim);font-weight:600">Activos</th>
              <th style="padding:6px;text-align:center;font-size:11px;color:var(--text-dim);font-weight:600">Conv.</th>
            </tr>
          </thead>
          <tbody>${sellerRows||'<tr><td colspan="5" style="padding:12px;text-align:center;color:var(--text-dim);font-size:13px">Sin datos</td></tr>'}</tbody>
        </table>
      </div>

      <div style="text-align:right;font-size:11px;color:var(--text-dim)">Actualizado: ${now.toLocaleString('es-VE')}</div>
    </div>`

  } catch(err) {
    document.getElementById('metrics-view').innerHTML =
      `<div style="color:#f87171;padding:20px">Error: ${err.message}</div>`
  }
}

// ─── MOBILE ────────────────────────────────────────────────
function mobSwitchTab(tab, el) {
  document.querySelectorAll('.mob-tab').forEach(t => t.classList.remove('active'))
  if (el) el.classList.add('active')
  if (tab === 'leads') switchView('list', null)
  else if (tab === 'embudo') switchView('kanban', null)
  else if (tab === 'settings') switchView('settings', null)
}

// On mobile: auto list view on load + keep badge updated
window.addEventListener('DOMContentLoaded', () => {
  if (window.innerWidth <= 768) {
    // Start in list view
    currentView = 'list'
  }
})

// Sync unread badge on mobile nav
const _origRenderAll = typeof renderAll === 'function' ? renderAll : null
function syncMobBadge() {
  const unread = leads.filter(l => l.unread).length
  const badge = document.getElementById('mob-badge-unread')
  if (badge) { badge.textContent = unread; badge.style.display = unread > 0 ? '' : 'none' }
}

// ─── USER MANAGEMENT ──────────────────────────────────────
const USER_COLORS = ['#1B6AEB','#0EA5E9','#7C3AED','#E1306C','#25D366','#F59E0B','#EF4444','#10B981','#F97316','#EC4899']
let _selectedUserColor = USER_COLORS[0]

async function loadCrmUsers() {
  try {
    const r = await db.from('crm_users').select('*').eq('active', true).order('created_at')
    if (r.data) {
      // Siempre usar los datos de BD (aunque sea lista vacía)
      // Si tabla existe y tiene datos → úsalos; si está vacía → lista vacía
      if (r.data.length > 0) {
        SELLERS = r.data.map(u => ({ id: u.id, name: u.name, role: u.role || 'vendedor', color: u.color || '#1B6AEB' }))
      }
      // Si hay error de RLS o tabla vacía por primera vez, mantener SELLERS actuales
    }
  } catch(e) { /* tabla no disponible, usar defaults */ }
  renderSellersSidebar()
  renderUsersSection()
}

function renderSellersSidebar() {
  const el = document.getElementById('sellers-sidebar')
  if (!el) return
  el.innerHTML = `<div class="sidebar-label">Usuarios</div>` +
    SELLERS.map(s => `<div class="sidebar-item" onclick="filterBy('seller-${s.name}',this)">
      <div style="width:14px;height:14px;border-radius:50%;background:${s.color};display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:#fff;flex-shrink:0">${s.name[0].toUpperCase()}</div>${s.name}
    </div>`).join('')
}

function isCurrentUserAdmin() {
  // Emails admin del propietario
  const adminEmails = ['lenuam16@gmail.com', 'jpablos.kersa@gmail.com']
  if (currentUser?.email && adminEmails.includes(currentUser.email)) return true
  // Verificar por rol en SELLERS
  const me = SELLERS.find(s => s.name === currentSellerName)
  if (me?.role === 'admin') return true
  // Fallback: nombre conocido del admin
  if (currentSellerName === 'Jose Manuel') return true
  return false
}

function renderUsersSection() {
  const el = document.getElementById('users-list')
  if (!el) return
  const amAdmin = isCurrentUserAdmin()
  el.innerHTML = SELLERS.length ? SELLERS.map(s => `
    <div style="display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--surface2);border-radius:10px;margin-bottom:8px">
      <div style="width:40px;height:40px;border-radius:50%;background:${s.color};display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#fff;flex-shrink:0">${s.name[0].toUpperCase()}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:600;font-size:13px;color:var(--text)">${s.name}</div>
        <div style="font-size:11px;color:var(--text-muted);text-transform:capitalize">${s.role || 'vendedor'}${s.role==='admin'?' 👑':''}</div>
      </div>
      ${amAdmin ? `<button onclick="startEditUser('${s.id||s.name}')" title="Editar" style="font-size:13px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text-muted);cursor:pointer">✏️</button>` : ''}
      ${amAdmin && s.name !== currentSellerName ? `<button onclick="deleteUser('${s.id||s.name}','${s.name}')" title="Eliminar" style="font-size:13px;padding:6px 10px;border:1px solid rgba(239,68,68,0.3);border-radius:6px;background:rgba(239,68,68,0.08);color:#EF4444;cursor:pointer">🗑️</button>` : ''}
    </div>`).join('')
    : `<div style="font-size:13px;color:var(--text-muted);text-align:center;padding:24px">Sin usuarios. Agrega uno.</div>`
}

function _colorPaletteHTML(selected) {
  return USER_COLORS.map(c => `<div onclick="_pickColor(this,'${c}')" style="width:28px;height:28px;border-radius:50%;background:${c};cursor:pointer;border:3px solid ${c===selected?'#fff':'transparent'};box-shadow:${c===selected?'0 0 0 2px '+c:'none'};transition:all 0.15s;flex-shrink:0"></div>`).join('')
}
function _pickColor(el, c) {
  _selectedUserColor = c
  el.closest('#add-user-form').querySelectorAll('[onclick^="_pickColor"]').forEach(d => {
    d.style.border = '3px solid transparent'; d.style.boxShadow = 'none'
  })
  el.style.border = '3px solid #fff'; el.style.boxShadow = `0 0 0 2px ${c}`
}
function _userFormHTML(title, name, role, color, email, saveFn, isSelf) {
  _selectedUserColor = color
  const pwdSection = isSelf ? `
    <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:16px">
      <div style="font-size:11px;font-weight:700;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:10px">CAMBIAR CONTRASEÑA</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div>
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Nueva contraseña</div>
          <input id="uf-pwd" type="password" class="form-input" placeholder="••••••••" style="font-size:13px">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Confirmar</div>
          <input id="uf-pwd2" type="password" class="form-input" placeholder="••••••••" style="font-size:13px">
        </div>
      </div>
      <div style="font-size:11px;color:var(--text-muted);margin-top:6px">Deja vacío para no cambiar la contraseña actual.</div>
    </div>` : `
    <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:16px">
      <div style="font-size:11px;font-weight:700;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:10px">CAMBIAR CONTRASEÑA</div>
      <div style="margin-bottom:10px">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Correo del usuario</div>
        <input id="uf-email" class="form-input" value="${email||''}" placeholder="correo@gmail.com" style="font-size:13px">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div>
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Nueva contraseña</div>
          <input id="uf-pwd" type="password" class="form-input" placeholder="••••••••" style="font-size:13px">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Confirmar</div>
          <input id="uf-pwd2" type="password" class="form-input" placeholder="••••••••" style="font-size:13px">
        </div>
      </div>
      <div style="font-size:11px;color:var(--text-muted);margin-top:6px">La contraseña cambia al instante. Sin envío de correo.</div>
    </div>`
  return `
    <div style="font-weight:700;font-size:11px;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:12px">${title}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
      <div>
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Nombre *</div>
        <input id="uf-name" class="form-input" value="${name}" placeholder="Nombre completo" style="font-size:13px">
      </div>
      <div>
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px">Rol</div>
        <select id="uf-role" class="form-select" style="font-size:13px">
          ${['vendedor','vendedora','admin','soporte'].map(r=>`<option value="${r}"${r===role?' selected':''}>${r.charAt(0).toUpperCase()+r.slice(1)}</option>`).join('')}
        </select>
      </div>
    </div>
    <div style="margin-bottom:14px">
      <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px">Color</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">${_colorPaletteHTML(color)}</div>
    </div>
    ${pwdSection}
    <div style="display:flex;gap:8px;margin-top:16px">
      <button onclick="${saveFn}" class="btn-primary" style="flex:1;font-size:13px">Guardar</button>
      <button onclick="hideUserForm()" class="btn-ghost" style="font-size:13px">Cancelar</button>
    </div>`
}

async function _sendPwdReset() {
  const email = (document.getElementById('uf-email')?.value || '').trim()
  if (!email) { showToast('⚠️ Ingresa el correo del usuario'); return }
  const { error } = await db.auth.resetPasswordForEmail(email, {
    redirectTo: window.location.origin + window.location.pathname
  })
  if (error) { showToast('⚠️ ' + error.message); return }
  showToast('✅ Email de restablecimiento enviado a ' + email)
}

function showAddUserForm() {
  const form = document.getElementById('add-user-form')
  form.innerHTML = _userFormHTML('NUEVO USUARIO','','vendedor', USER_COLORS[0], '', 'saveNewUser()', false)
  form.style.display = 'block'
  form.scrollIntoView({ behavior:'smooth', block:'nearest' })
}
function hideUserForm() {
  const form = document.getElementById('add-user-form')
  form.style.display = 'none'; form.innerHTML = ''
}

async function saveNewUser() {
  const name = (document.getElementById('uf-name')?.value || '').trim()
  const role = document.getElementById('uf-role')?.value || 'vendedor'
  if (!name) { showToast('⚠️ Ingresa el nombre'); return }
  let ok = false
  try {
    const r = await db.from('crm_users').insert({ name, role, color: _selectedUserColor, active: true }).select().single()
    if (r.error) throw r.error
    ok = true
  } catch(e) {
    SELLERS.push({ id: 'local_'+Date.now(), name, role, color: _selectedUserColor })
    showToast('✅ Usuario agregado (crea la tabla crm_users para persistir)')
    hideUserForm(); renderSellersSidebar(); renderUsersSection(); return
  }
  if (ok) { showToast('✅ Usuario creado'); hideUserForm(); await loadCrmUsers() }
}

function startEditUser(idOrName) {
  const s = SELLERS.find(u => (u.id||u.name) === idOrName)
  if (!s) return
  const isSelf = s.name === currentSellerName
  const form = document.getElementById('add-user-form')
  form.innerHTML = _userFormHTML('EDITAR USUARIO', s.name, s.role||'vendedor', s.color||USER_COLORS[0], s.email||'', `saveEditUser('${idOrName}')`, isSelf)
  form.style.display = 'block'
  form.scrollIntoView({ behavior:'smooth', block:'nearest' })
}

async function saveEditUser(idOrName) {
  const name = (document.getElementById('uf-name')?.value || '').trim()
  const role = document.getElementById('uf-role')?.value || 'vendedor'
  const email = (document.getElementById('uf-email')?.value || '').trim()
  const pwd = (document.getElementById('uf-pwd')?.value || '')
  const pwd2 = (document.getElementById('uf-pwd2')?.value || '')
  if (!name) { showToast('⚠️ Ingresa el nombre'); return }
  if (pwd && pwd !== pwd2) { showToast('⚠️ Las contraseñas no coinciden'); return }
  if (pwd && pwd.length < 6) { showToast('⚠️ Mínimo 6 caracteres'); return }
  const s = SELLERS.find(u => (u.id||u.name) === idOrName)
  if (!s) return
  const isSelf = s.name === currentSellerName
  const updateData = { name, role, color: _selectedUserColor }
  if (email) updateData.email = email
  try {
    if (s.id && !s.id.startsWith('local_')) {
      const r = await db.from('crm_users').update(updateData).eq('id', s.id)
      if (r.error) throw r.error
    } else throw new Error('local')
  } catch(e) { Object.assign(s, { name, role, color: _selectedUserColor }) }
  if (pwd) {
    if (isSelf) {
      const { error } = await db.auth.updateUser({ password: pwd })
      if (error) { showToast('⚠️ ' + error.message); return }
      showToast('✅ Contraseña actualizada')
    } else {
      const userEmail = email || s.email
      if (!userEmail) { showToast('⚠️ Ingresa el correo del usuario para cambiar la contraseña'); return }
      const res = await fetch('https://awscrogqprosivmtgkio.supabase.co/functions/v1/smooth-api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + SUPABASE_ANON_KEY },
        body: JSON.stringify({ type: 'admin_change_password', email: userEmail, new_password: pwd })
      })
      const result = await res.json()
      if (result.error) { showToast('⚠️ ' + result.error); return }
      showToast('✅ Contraseña cambiada. El usuario ya puede entrar con la nueva clave.')
    }
  } else {
    showToast('✅ Usuario actualizado')
  }
  hideUserForm(); await loadCrmUsers(); renderAll()
}

async function deleteUser(idOrName, userName) {
  if (!isCurrentUserAdmin()) { showToast('❌ Solo el admin puede eliminar usuarios'); return }
  if (!confirm(`¿Eliminar a ${userName}? Esta acción no se puede deshacer.`)) return

  const s = SELLERS.find(u => (u.id||u.name) === idOrName)
  if (!s) return

  let serverOk = false

  if (s.id && !s.id.startsWith('local_')) {
    // Try soft delete (active=false)
    const { error: updErr } = await db.from('crm_users').update({ active: false }).eq('id', s.id)
    if (updErr) {
      // Soft delete failed — try hard delete
      const { error: delErr } = await db.from('crm_users').delete().eq('id', s.id)
      if (delErr) {
        showToast('⚠️ Error en BD: ' + delErr.message + ' — eliminado localmente')
      } else {
        serverOk = true
      }
    } else {
      serverOk = true
    }
  } else {
    // Local-only user, no DB record
    serverOk = true
  }

  // Always remove from local array immediately
  SELLERS = SELLERS.filter(u => (u.id||u.name) !== idOrName)

  if (serverOk) {
    // Safe to reload from DB — server record is gone
    await loadCrmUsers()
  } else {
    // Server failed: DON'T reload from DB (it would bring the user back)
    renderSellersSidebar()
    renderUsersSection()
  }

  renderAll()
  showToast('🗑️ ' + userName + ' eliminada')
}

async function deleteLead(leadId, leadName) {
  if (!isCurrentUserAdmin()) { showToast('❌ Solo el admin puede eliminar leads'); return }
  if (!confirm(`¿Eliminar "${leadName}"?\nSe eliminarán todos sus mensajes y notas.\nEsta acción no se puede deshacer.`)) return

  await db.from('messages').delete().eq('lead_id', leadId)
  await db.from('notes').delete().eq('lead_id', leadId)
  const { error } = await db.from('leads').delete().eq('id', leadId)
  if (error) { showToast('⚠️ Error al eliminar: ' + error.message); return }

  leads = leads.filter(l => l.id !== leadId)
  if (selectedLeadId === leadId) { selectedLeadId = null; closeDetail() }
  renderAll()
  showToast('🗑️ Lead eliminado')
}

// ─── ASIGNACIONES ───────────────────────────────────────────
const PLATFORMS = ['WhatsApp','Instagram','Facebook','TikTok']
let ASSIGN_RULES = {
  platform: { WhatsApp:'', Instagram:'', Facebook:'', TikTok:'' },
  round_robin: true,
  round_robin_sellers: [],
  rr_index: 0
}

function loadAssignRules() {
  try {
    const saved = JSON.parse(localStorage.getItem('kersa_assign_rules') || '{}')
    ASSIGN_RULES = {
      platform: Object.assign({ WhatsApp:'', Instagram:'', Facebook:'', TikTok:'' }, saved.platform || {}),
      round_robin: saved.round_robin !== undefined ? saved.round_robin : true,
      round_robin_sellers: saved.round_robin_sellers || [],
      rr_index: saved.rr_index || 0
    }
  } catch(e) {}
}

function saveAssignRules() {
  localStorage.setItem('kersa_assign_rules', JSON.stringify(ASSIGN_RULES))
}

function autoAssignSeller(platform) {
  const sel = document.getElementById('new-seller')
  if (!sel) return
  const ruleSeller = ASSIGN_RULES.platform[platform]
  if (ruleSeller && SELLERS.find(s => s.name === ruleSeller)) {
    sel.value = ruleSeller
    return
  }
  if (ASSIGN_RULES.round_robin) {
    const pool = ASSIGN_RULES.round_robin_sellers.length > 0
      ? SELLERS.filter(s => ASSIGN_RULES.round_robin_sellers.includes(s.name))
      : SELLERS
    if (pool.length > 0) {
      const idx = ASSIGN_RULES.rr_index % pool.length
      sel.value = pool[idx].name
      ASSIGN_RULES.rr_index = (idx + 1) % pool.length
      saveAssignRules()
    }
  }
}

function renderAssignSection() {
  const el = document.getElementById('assign-section')
  if (!el) return
  const sellerOpts = ['', ...SELLERS.map(s => s.name)]
  const platformRows = PLATFORMS.map(p => {
    const assigned = ASSIGN_RULES.platform[p] || ''
    const pc = platColor(p); const pi = platIcon(p)
    return `<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border)">
      <span style="display:inline-flex;align-items:center;gap:5px;background:${pc};color:#fff;font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.5px;text-transform:uppercase;min-width:110px">${pi} ${p}</span>
      <select onchange="ASSIGN_RULES.platform['${p}']=this.value;saveAssignRules()" class="form-select" style="flex:1;font-size:13px">
        ${sellerOpts.map(s => `<option value="${s}"${s===assigned?' selected':''}>${s || '— Round Robin —'}</option>`).join('')}
      </select>
    </div>`
  }).join('')

  const rrChecks = SELLERS.map(s => {
    const checked = ASSIGN_RULES.round_robin_sellers.length === 0 || ASSIGN_RULES.round_robin_sellers.includes(s.name)
    return `<label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;padding:4px 10px;border-radius:20px;background:var(--surface2)">
      <input type="checkbox" ${checked?'checked':''} onchange="toggleRRSeller('${s.name}',this.checked)" style="accent-color:${s.color||'#1B6AEB'}">
      <span style="width:16px;height:16px;border-radius:50%;background:${s.color||'#888'};display:inline-flex;align-items:center;justify-content:center;font-size:9px;color:#fff;font-weight:700">${s.name[0]}</span>
      ${s.name}
    </label>`
  }).join('')

  el.innerHTML = `
    <div style="font-size:11px;font-weight:700;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:10px">REGLA POR PLATAFORMA</div>
    <div style="margin-bottom:20px">${platformRows}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
      <div>
        <div style="font-size:11px;font-weight:700;letter-spacing:0.5px;color:var(--text-muted)">ROUND ROBIN (FALLBACK)</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:2px">Si no hay regla para la plataforma, asigna por turno rotativo</div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
        <input type="checkbox" id="rr-toggle" ${ASSIGN_RULES.round_robin?'checked':''} onchange="ASSIGN_RULES.round_robin=this.checked;saveAssignRules();renderAssignSection()" style="width:16px;height:16px">
      </label>
    </div>
    <div id="rr-sellers" style="display:${ASSIGN_RULES.round_robin?'flex':'none'};flex-wrap:wrap;gap:8px;padding:12px;background:var(--surface2);border-radius:8px">
      <div style="font-size:11px;color:var(--text-muted);width:100%;margin-bottom:4px">Participan en la rotación:</div>
      ${rrChecks}
    </div>`
}

function toggleRRSeller(name, checked) {
  if (ASSIGN_RULES.round_robin_sellers.length === 0) {
    ASSIGN_RULES.round_robin_sellers = SELLERS.map(s => s.name)
  }
  if (checked) {
    if (!ASSIGN_RULES.round_robin_sellers.includes(name)) ASSIGN_RULES.round_robin_sellers.push(name)
  } else {
    ASSIGN_RULES.round_robin_sellers = ASSIGN_RULES.round_robin_sellers.filter(n => n !== name)
  }
  if (ASSIGN_RULES.round_robin_sellers.length === SELLERS.length) ASSIGN_RULES.round_robin_sellers = []
  saveAssignRules()
}

// ─── WHATSAPP EVOLUTION API ─────────────────────────────────
async function loadWaStatus() {
  document.getElementById('wa-loading-section').style.display = 'block'
  document.getElementById('wa-qr-section').style.display = 'none'
  document.getElementById('wa-connected-section').style.display = 'none'
  try {
    const res = await fetch(`${EVOLUTION_URL}/instance/fetchInstances`, {
      headers: { 'apikey': EVOLUTION_KEY }
    })
    const data = await res.json()
    const inst = Array.isArray(data) ? data.find(i => i.name === EVOLUTION_INSTANCE || i.instance?.instanceName === EVOLUTION_INSTANCE) : (data?.name === EVOLUTION_INSTANCE ? data : null)
    const state = inst?.connectionStatus || inst?.instance?.connectionStatus || inst?.instance?.state || 'disconnected'
    document.getElementById('wa-loading-section').style.display = 'none'
    if (state === 'open') {
      const phone = inst?.number || inst?.instance?.number || ''
      document.getElementById('wa-phone-label').textContent = phone ? `+${phone}` : 'Número activo'
      document.getElementById('wa-connected-section').style.display = 'block'
      document.getElementById('wa-status-badge').textContent = '🟢 Conectado'
      document.getElementById('wa-status-badge').style.color = '#25d366'
      document.getElementById('wa-integ-status').textContent = 'Conectado'
      document.getElementById('wa-integ-status').style.background = 'rgba(37,211,102,0.15)'
      document.getElementById('wa-integ-status').style.color = '#25d366'
    } else {
      document.getElementById('wa-status-badge').textContent = '🔴 Desconectado'
      document.getElementById('wa-status-badge').style.color = 'var(--text-muted)'
      await loadWaQR()
    }
  } catch(e) {
    document.getElementById('wa-loading-section').style.display = 'none'
    document.getElementById('wa-status-badge').textContent = '⚠️ Error de conexión'
    console.error('WA status error:', e)
  }
}

async function loadWaQR() {
  document.getElementById('wa-qr-section').style.display = 'none'
  try {
    const res = await fetch(`${EVOLUTION_URL}/instance/connect/${EVOLUTION_INSTANCE}`, {
      headers: { 'apikey': EVOLUTION_KEY }
    })
    const data = await res.json()
    if (data.base64) {
      document.getElementById('wa-qr-img').src = data.base64
      document.getElementById('wa-qr-section').style.display = 'block'
      document.getElementById('wa-connected-section').style.display = 'none'
    } else if (data.instance?.state === 'open') {
      await loadWaStatus()
    }
  } catch(e) {
    showToast('⚠️ Error al obtener QR')
    console.error('WA QR error:', e)
  }
}

async function disconnectWa() {
  if (!confirm('¿Desconectar WhatsApp?')) return
  await fetch(`${EVOLUTION_URL}/instance/logout/${EVOLUTION_INSTANCE}`, {
    method: 'DELETE',
    headers: { 'apikey': EVOLUTION_KEY }
  })
  showToast('WhatsApp desconectado')
  await loadWaStatus()
}

// ─── TOAST ────────────────────────────────────────────────
function showToast(msg) {
  const el = document.getElementById('toast')
  if (!el) return
  el.textContent = msg
  el.classList.add('show')
  setTimeout(() => el.classList.remove('show'), 3000)
}

// ─── BADGES & STATS ───────────────────────────────────────
function updateBadges() {
  const all = leads.length
  const unread = leads.filter(l => l.unread).length
  const bAll = document.getElementById('badge-all')
  const bUnread = document.getElementById('badge-unread')
  if (bAll) bAll.textContent = all
  if (bUnread) { bUnread.textContent = unread; bUnread.style.display = unread > 0 ? 'inline-flex' : 'none' }
}
function updateStats() { updateBadges() }

// ─── MODAL ────────────────────────────────────────────────
function openNewLeadModal() {
  newLeadStage = 'nuevo'
  const sel = document.getElementById('new-seller')
  if (sel) sel.innerHTML = SELLERS.map(s=>`<option>${s.name}</option>`).join('')
  document.getElementById('modal-overlay').classList.add('open')
  const platSel = document.getElementById('new-platform')
  if (!platSel._assignListenerAdded) {
    platSel.addEventListener('change', () => autoAssignSeller(platSel.value))
    platSel._assignListenerAdded = true
  }
  setTimeout(() => { document.getElementById('new-name')?.focus(); autoAssignSeller(platSel?.value || 'Instagram') }, 100)
}
function openNewLeadModalInStage(stageId) {
  newLeadStage = stageId
  const sel = document.getElementById('new-seller')
  if (sel) sel.innerHTML = SELLERS.map(s=>`<option>${s.name}</option>`).join('')
  document.getElementById('modal-overlay').classList.add('open')
  const platSel = document.getElementById('new-platform')
  if (!platSel._assignListenerAdded) {
    platSel.addEventListener('change', () => autoAssignSeller(platSel.value))
    platSel._assignListenerAdded = true
  }
  setTimeout(() => { document.getElementById('new-name')?.focus(); autoAssignSeller(platSel?.value || 'Instagram') }, 100)
}
function closeModal() {
  document.getElementById('modal-overlay').classList.remove('open')
  ;['new-name','new-handle','new-message'].forEach(id => { const el = document.getElementById(id); if (el) el.value = '' })
}

// ─── DETAIL PANEL ─────────────────────────────────────────
function closeDetail() {
  document.getElementById('detail-panel').classList.remove('open')
  selectedLeadId = null
}
function switchDetailTab(tab, el) {
  activeDetailTab = tab
  document.querySelectorAll('.detail-tab').forEach(t => t.classList.remove('active'))
  if (el) el.classList.add('active')
  if (selectedLeadId) renderDetailBody()
}
function selectLead(id) {
  selectedLeadId = id
  const lead = leads.find(l => l.id === id)
  if (!lead) return
  if (lead.unread) markRead(id)
  document.getElementById('detail-panel').classList.add('open')
  renderDetailHeader(lead)
  activeDetailTab = 'messages'
  document.querySelectorAll('.detail-tab').forEach((t,i) => t.classList.toggle('active', i===0))
  renderDetailBody()
  renderDetailFooter(lead)
}
function renderDetailHeader(lead) {
  const stage = stageInfo(lead.stage)
  const platforms = (lead.platforms && lead.platforms.length) ? lead.platforms : (lead.platform ? [lead.platform] : ['Mensaje'])
  const colors = platforms.map(p => platColor(p))
  const pc = colors[0]
  const avCls = avClass(lead.id)

  // ── WhatsApp mobile header ──
  const waAvatar = document.getElementById('wa-avatar')
  const waName = document.getElementById('wa-name')
  const waSub = document.getElementById('wa-sub')
  if (waAvatar) {
    waAvatar.className = `wa-avatar ${avCls}`
    waAvatar.textContent = initials(lead.name)
  }
  if (waName) waName.textContent = lead.name
  if (waSub) waSub.innerHTML = platforms.map(p =>
    `<span class="wa-plat-badge" style="background:${platColor(p)}">${platIcon(p)} ${p}</span>`
  ).join('') + `<span style="margin-left:4px;color:#aebac1">${stage.label}</span>`

  // ── Desktop header (unchanged look) ──
  const bannerBg = colors.length > 1 ? `linear-gradient(135deg, ${colors.join(', ')})` : colors[0]
  document.getElementById('detail-panel').style.borderLeft = `3px solid ${pc}`
  const closeBtn = document.querySelector('.detail-close')
  if (closeBtn) { closeBtn.style.cssText = 'position:absolute;top:14px;right:14px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:6px;cursor:pointer;color:#fff;background:rgba(255,255,255,0.25);font-size:16px;border:none;z-index:3' }
  document.getElementById('detail-header').innerHTML = `
    <div style="background:${bannerBg};margin:-16px -16px 16px -16px;padding:12px 52px 12px 16px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;min-height:44px">
      ${platforms.map(p => `<span style="background:rgba(255,255,255,0.22);color:#fff;font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.5px;text-transform:uppercase;display:inline-flex;align-items:center;gap:4px">${platIcon(p)} ${p}</span>`).join('')}
    </div>
    <div class="detail-lead-info">
      <div class="detail-avatar ${avCls}" style="border:3px solid ${pc};box-shadow:0 0 0 3px ${pc}33">${initials(lead.name)}</div>
      <div>
        <div class="detail-name">${lead.name}</div>
        <div class="detail-meta"><span class="${stage.statusClass}" style="font-size:10px;padding:2px 7px;border-radius:10px;font-weight:600">${stage.label}</span></div>
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
      <select class="form-select" style="font-size:11px;padding:4px 8px;height:auto" onchange="changeStage('${lead.id}',this.value)">
        ${STAGES.map(s=>`<option value="${s.id}"${s.id===lead.stage?' selected':''}>${s.label}</option>`).join('')}
      </select>
      <select class="form-select" style="font-size:11px;padding:4px 8px;height:auto" onchange="changeSeller('${lead.id}',this.value)">
        ${SELLERS.map(s=>`<option value="${s.name}"${s.name===lead.seller?' selected':''}>${s.name}</option>`).join('')}
      </select>
    </div>
    ${lead.handle?`<div style="font-size:11px;color:var(--text-muted);margin-top:6px">${lead.handle}</div>`:''}
  `
}
function platColor(p) {
  return { WhatsApp:'#25D366', Instagram:'#E1306C', Facebook:'#1877F2', TikTok:'#00f2ea' }[p] || '#888'
}
function platIcon(p) {
  return { WhatsApp:'💬', Instagram:'📸', Facebook:'👤', TikTok:'🎵' }[p] || '📱'
}
function renderDetailBody() {
  const lead = leads.find(l => l.id === selectedLeadId)
  if (!lead) return
  const body = document.getElementById('detail-body')
  if (activeDetailTab === 'messages') {
    const msgs = (lead.messages||[]).slice().sort((a,b)=>new Date(a.created_at)-new Date(b.created_at))
    const pc = platColor(lead.platform)
    const pi = platIcon(lead.platform)
    if (!msgs.length) {
      body.innerHTML = `<div style="text-align:center;color:#8696a0;font-size:13px;padding:40px 0">Sin mensajes aún</div>`
    } else {
      body.innerHTML = msgs.map((m, i) => {
        const isTeam = m.from_type === 'team'
        const prev = msgs[i-1]
        const sameDir = prev && (prev.from_type === 'team') === isTeam
        const timeStr = formatTime(m.created_at)

        // Media content
        let mediaHtml = ''
        if (m.media_url) {
          const mt = m.media_type || ''
          if (mt.startsWith('image/')) {
            mediaHtml = `<img src="${m.media_url}" class="msg-img" onclick="window.open('${m.media_url}','_blank')" style="max-width:220px;border-radius:6px;display:block;margin-bottom:4px">`
          } else if (mt.startsWith('video/')) {
            mediaHtml = `<video src="${m.media_url}" controls style="max-width:220px;border-radius:6px;display:block;margin-bottom:4px"></video>`
          } else if (mt.startsWith('audio/')) {
            mediaHtml = `<audio src="${m.media_url}" controls class="msg-audio" style="margin-bottom:4px"></audio>`
          } else {
            mediaHtml = `<div class="msg-file"><span>📎</span><a href="${m.media_url}" target="_blank" style="color:#00a884;font-size:12px;word-break:break-all">${m.media_name||'Archivo'}</a></div>`
          }
        }

        const content = `${mediaHtml}${!m.media_url || m.text !== '📷 Imagen' && m.text !== '🎤 Nota de voz' && m.text !== '🎬 Video' ? `<span>${m.text}</span>` : ''}`

        if (isTeam) {
          return `<div style="display:flex;justify-content:flex-end;margin-bottom:${sameDir?'2':'8'}px">
            <div style="max-width:78%;background:#005c4b;color:#e9edef;padding:7px 11px 5px;border-radius:${sameDir?'7.5px':'7.5px 7.5px 0 7.5px'};font-size:13.5px;line-height:1.45;word-break:break-word">
              ${content}
              <div style="font-size:10px;color:rgba(233,237,239,0.6);margin-top:4px;text-align:right">${timeStr} ✓✓</div>
            </div>
          </div>`
        } else {
          return `<div style="display:flex;flex-direction:column;align-items:flex-start;margin-bottom:${sameDir?'2':'8'}px">
            ${!sameDir ? `<div style="display:inline-flex;align-items:center;gap:4px;background:${pc};color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;margin-bottom:4px;letter-spacing:0.4px;text-transform:uppercase">${pi} ${lead.platform||'Mensaje'}</div>` : ''}
            <div style="max-width:78%;background:#202c33;color:#e9edef;padding:7px 11px 5px;border-radius:${sameDir?'7.5px':'0 7.5px 7.5px 7.5px'};font-size:13.5px;line-height:1.45;word-break:break-word">
              ${content}
              <div style="font-size:10px;color:rgba(233,237,239,0.5);margin-top:4px">${timeStr}</div>
            </div>
          </div>`
        }
      }).join('')
    }
    setTimeout(()=>{ body.scrollTop = body.scrollHeight }, 50)
  } else if (activeDetailTab === 'notes') {
    const notes = (lead.notes||[]).slice().sort((a,b)=>new Date(b.created_at)-new Date(a.created_at))
    body.innerHTML = `
      <div style="margin-bottom:12px">
        <textarea id="note-input" class="form-textarea" placeholder="Escribe una nota..." style="margin-bottom:8px"></textarea>
        <button class="btn-primary" style="width:100%;font-size:12px" onclick="addNote('${lead.id}')">Guardar nota</button>
      </div>
      ${notes.map(n=>`<div style="background:var(--surface2);padding:10px 12px;border-radius:8px;margin-bottom:8px"><div style="font-size:11px;font-weight:600;color:var(--text-muted);margin-bottom:4px">${n.author} · ${formatDate(n.created_at)}</div><div style="font-size:13px">${n.text}</div></div>`).join('')}`
  } else {
    body.innerHTML = `<div style="font-size:13px;display:flex;flex-direction:column;gap:12px">
      <div><div style="color:var(--text-muted);font-size:11px;margin-bottom:3px">PLATAFORMA</div>${lead.platform}</div>
      <div><div style="color:var(--text-muted);font-size:11px;margin-bottom:3px">CONTACTO</div>${lead.handle||'—'}</div>
      <div><div style="color:var(--text-muted);font-size:11px;margin-bottom:3px">VENDEDORA</div>${lead.seller}</div>
      <div><div style="color:var(--text-muted);font-size:11px;margin-bottom:3px">ETAPA</div>${stageInfo(lead.stage).label}</div>
      <div><div style="color:var(--text-muted);font-size:11px;margin-bottom:3px">REGISTRADO</div>${formatDate(lead.created_at)}</div>
    </div>`
  }
}
function renderDetailFooter(lead) {
  const lid = lead.id
  document.getElementById('detail-footer').innerHTML = `
    <div class="msg-input-area" style="padding-bottom:calc(8px + env(safe-area-inset-bottom,0px))">

      <!-- Un solo botón de adjuntar (archivos + fotos + videos) -->
      <button class="wa-btn-icon" title="Adjuntar" onclick="document.getElementById('wa-file-${lid}').click()">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/></svg>
      </button>
      <input type="file" id="wa-file-${lid}" style="display:none" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx" onchange="sendFile('${lid}',this)">

      <!-- Input / indicador de grabación -->
      <div style="flex:1;position:relative;min-width:0">
        <input id="msg-input" class="msg-input" type="text"
          placeholder="Escribe un mensaje..."
          style="width:100%;box-sizing:border-box"
          onkeydown="if(event.key==='Enter')sendMessage('${lid}')">
        <div class="recording-bar" id="rec-bar-${lid}">
          <div class="rec-dot"></div>
          <span id="rec-timer-${lid}">0:00</span>
          <span style="color:#8696a0;font-size:11px;flex:1">Nota de voz... suelta para enviar</span>
        </div>
      </div>

      <!-- Micrófono: visible cuando no hay texto -->
      <button class="msg-send" id="wa-mic-${lid}"
        style="background:#00a884;touch-action:none"
        ontouchstart="startVoiceNote('${lid}');event.preventDefault()"
        ontouchend="stopVoiceNote('${lid}');event.preventDefault()"
        onmousedown="startVoiceNote('${lid}')"
        onmouseup="stopVoiceNote('${lid}')"
        oncontextmenu="return false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="#fff"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
      </button>

      <!-- Enviar: visible cuando hay texto -->
      <button class="msg-send" id="wa-send-${lid}"
        style="display:none"
        onclick="sendMessage('${lid}')">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="#fff"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>

    </div>`

  // Toggle mic ↔ send depending on whether there's text
  const inp     = document.getElementById('msg-input')
  const sendBtn = document.getElementById(`wa-send-${lid}`)
  const micBtn  = document.getElementById(`wa-mic-${lid}`)
  if (inp && sendBtn && micBtn) {
    inp.addEventListener('input', () => {
      const has = inp.value.trim().length > 0
      micBtn.style.display  = has ? 'none' : 'flex'
      sendBtn.style.display = has ? 'flex' : 'none'
    })
  }
}

// ─── FILE / MEDIA UPLOAD ───────────────────────────────────
async function sendFile(leadId, input) {
  const file = input.files[0]
  if (!file) return
  input.value = ''
  showToast('⏳ Subiendo...')
  try {
    const ext = file.name.split('.').pop().toLowerCase()
    const path = `${leadId}/${Date.now()}_${Math.random().toString(36).slice(2)}.${ext}`
    const { error: upErr } = await db.storage.from('crm-media').upload(path, file, { upsert: true })
    if (upErr) throw upErr
    const { data: urlData } = db.storage.from('crm-media').getPublicUrl(path)
    const isImg = file.type.startsWith('image/')
    const isVid = file.type.startsWith('video/')
    const label = isImg ? '📷 Imagen' : isVid ? '🎬 Video' : `📎 ${file.name}`
    await db.from('messages').insert({
      lead_id: leadId,
      text: label,
      from_type: 'team',
      media_url: urlData.publicUrl,
      media_type: file.type,
      media_name: file.name,
      created_at: new Date().toISOString()
    })
    showToast('✅ Enviado')
    await fetchLeads()
    if (selectedLeadId === leadId) renderDetailBody()
  } catch(e) {
    console.error(e)
    showToast('❌ ' + (e.message?.includes('bucket') ? 'Bucket crm-media no configurado' : (e.message || 'Error al subir')))
  }
}

// ─── VOICE NOTE ────────────────────────────────────────────
let _mediaRec = null, _audioChunks = [], _recInterval = null, _recSecs = 0

async function startVoiceNote(leadId) {
  if (_mediaRec) return
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
    _audioChunks = []; _recSecs = 0
    _mediaRec = new MediaRecorder(stream)
    _mediaRec.ondataavailable = e => { if (e.data.size > 0) _audioChunks.push(e.data) }
    _mediaRec.onstop = async () => {
      stream.getTracks().forEach(t => t.stop())
      clearInterval(_recInterval)
      document.getElementById(`rec-bar-${leadId}`)?.classList.remove('active')
      document.getElementById('msg-input') && (document.getElementById('msg-input').style.display = '')
      if (_audioChunks.length && _recSecs >= 1) {
        const blob = new Blob(_audioChunks, { type: 'audio/webm' })
        const path = `${leadId}/voice_${Date.now()}.webm`
        showToast('⏳ Enviando nota de voz...')
        try {
          const { error } = await db.storage.from('crm-media').upload(path, blob, { upsert: true })
          if (error) throw error
          const { data: urlData } = db.storage.from('crm-media').getPublicUrl(path)
          await db.from('messages').insert({
            lead_id: leadId, text: '🎤 Nota de voz',
            from_type: 'team', media_url: urlData.publicUrl,
            media_type: 'audio/webm', media_name: 'nota_voz.webm',
            created_at: new Date().toISOString()
          })
          showToast('✅ Nota de voz enviada')
          await fetchLeads()
          if (selectedLeadId === leadId) renderDetailBody()
        } catch(e) { showToast('❌ ' + (e.message || 'Error')) }
      }
      _mediaRec = null
    }
    _mediaRec.start(200)
    // Show recording UI
    const msgInput = document.getElementById('msg-input')
    const recBar = document.getElementById(`rec-bar-${leadId}`)
    if (msgInput) msgInput.style.display = 'none'
    if (recBar) recBar.classList.add('active')
    _recInterval = setInterval(() => {
      _recSecs++
      const t = document.getElementById(`rec-timer-${leadId}`)
      if (t) t.textContent = `${Math.floor(_recSecs/60)}:${String(_recSecs%60).padStart(2,'0')}`
    }, 1000)
  } catch(e) {
    showToast('❌ Micrófono no disponible')
    _mediaRec = null
  }
}

function stopVoiceNote(leadId) {
  if (_mediaRec && _mediaRec.state === 'recording') _mediaRec.stop()
}

init()

// ─── KANBAN: scroll horizontal con rueda del ratón ────────
document.addEventListener('wheel', (e) => {
  const wrap = e.target.closest('.kanban-wrapper')
  if (!wrap) return
  // Si el mouse está sobre el cuerpo de una columna, dejar scroll vertical normal
  if (e.target.closest('.col-body')) return
  // Fuera de las columnas → convertir scroll vertical en horizontal
  if (Math.abs(e.deltaY) >= Math.abs(e.deltaX)) {
    e.preventDefault()
    wrap.scrollLeft += e.deltaY * 1.5
  }
}, { passive: false })
</script>
</body>
</html>
