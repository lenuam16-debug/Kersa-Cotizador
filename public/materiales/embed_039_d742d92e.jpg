<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content">
<title>Kersa CRM</title>

<!-- PWA -->
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#1B6AEB">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Kersa CRM">
<link rel="apple-touch-icon" href="/icon.svg">

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root {
    --bg: #141C2B;
    --surface: #1B2439;
    --surface2: #212D47;
    --surface3: #273557;
    --border: #2A3D60;
    --blue: #1B6AEB;
    --blue-light: #3D85F5;
    --blue-dim: rgba(27,106,235,0.13);
    --blue-border: rgba(27,106,235,0.35);
    --text: #DCE8FA;
    --text-muted: #6888B4;
    --text-dim: #374F78;
    --ig: linear-gradient(135deg,#E1306C,#833AB4);
    --wa: #25D366;
    --fb: #1877F2;
    --tt: #ffffff;
    --red: #E05C5C;
    --green: #4CAF88;
    --yellow: #D4A843;
    --radius: 10px;
    --radius-sm: 6px;
    --shadow: 0 4px 24px rgba(0,0,0,0.5);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ───────── LOGIN SCREEN ───────── */
  .login-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0;
  }
  .login-overlay.hidden { display: none; }

  .login-box {
    width: 380px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 36px 32px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.5);
  }
  .login-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }
  .login-title {
    font-size: 19px;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    color: var(--text);
    margin-bottom: 6px;
  }
  .login-sub {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .login-error {
    background: rgba(224,92,92,0.1);
    border: 1px solid rgba(224,92,92,0.3);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 13px;
    color: var(--red);
    margin-bottom: 14px;
    display: none;
  }
  .login-spinner {
    display: none;
    text-align: center;
    padding: 10px 0;
    color: var(--text-muted);
    font-size: 13px;
  }

  /* ───────── LOADING SCREEN ───────── */
  .loading-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 16px;
  }
  .loading-overlay.hidden { display: none; }
  .loading-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
  .loading-dots {
    display: flex;
    gap: 6px;
  }
  .loading-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--blue);
    animation: pulse 1.2s infinite;
  }
  .loading-dot:nth-child(2) { animation-delay: 0.2s; }
  .loading-dot:nth-child(3) { animation-delay: 0.4s; }
  .loading-text { font-size: 13px; color: var(--text-muted); }

  /* ───────── NOT CONFIGURED ───────── */
  .config-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg);
    z-index: 9998;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .config-overlay.show { display: flex; }
  .config-box {
    width: 520px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 36px;
  }
  .config-step {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    padding: 16px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .config-num {
    width: 28px; height: 28px;
    background: var(--blue);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    color: #fff;
    flex-shrink: 0;
  }
  .config-step-title { font-weight: 600; font-size: 14px; margin-bottom: 4px; font-family: 'Montserrat', sans-serif; }
  .config-step-desc { font-size: 12px; color: var(--text-muted); line-height: 1.5; }
  .config-url {
    font-family: monospace;
    font-size: 12px;
    background: var(--surface3);
    color: var(--blue-light);
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* ───────── HEADER ───────── */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 56px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    z-index: 100;
  }

  .logo { display: flex; align-items: center; gap: 10px; }
  .logo-mark {
    width: 32px; height: 32px;
    background: var(--blue);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-weight: 800; font-size: 14px;
    color: #ffffff; letter-spacing: -0.5px;
  }
  .logo-text { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 0.5px; color: var(--text); }
  .logo-text span { color: var(--blue-light); }
  .logo-sub { font-size: 10px; font-weight: 400; color: var(--text-muted); letter-spacing: 2px; text-transform: uppercase; margin-top: -2px; display: block; }

  .nav-tabs { display: flex; gap: 4px; }
  .nav-tab {
    padding: 6px 16px; border-radius: var(--radius-sm);
    font-size: 13px; font-weight: 500; cursor: pointer;
    color: var(--text-muted); transition: all 0.2s;
    border: 1px solid transparent;
  }
  .nav-tab:hover { color: var(--text); background: var(--surface2); }
  .nav-tab.active { color: var(--blue-light); background: var(--blue-dim); border-color: var(--blue-border); }

  .header-right { display: flex; align-items: center; gap: 12px; }

  .btn-primary {
    background: var(--blue); color: #ffffff;
    border: none; padding: 7px 16px;
    border-radius: var(--radius-sm); font-size: 13px; font-weight: 600;
    font-family: 'Montserrat', sans-serif; cursor: pointer;
    transition: all 0.2s; letter-spacing: 0.3px;
  }
  .btn-primary:hover { background: var(--blue-light); }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-ghost {
    background: transparent; color: var(--text-muted);
    border: 1px solid var(--border); padding: 6px 14px;
    border-radius: var(--radius-sm); font-size: 13px; font-weight: 500;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-ghost:hover { color: var(--text); border-color: var(--text-dim); }

  .user-chip {
    display: flex; align-items: center; gap: 8px;
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 20px; padding: 4px 12px 4px 4px; cursor: pointer;
    transition: all 0.15s;
  }
  .user-chip:hover { border-color: var(--blue-border); }
  .avatar {
    width: 26px; height: 26px;
    background: var(--blue);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 11px; color: #ffffff;
    font-family: 'Montserrat', sans-serif;
  }
  .user-name { font-size: 12px; font-weight: 600; color: var(--text-muted); font-family: 'Montserrat', sans-serif; }

  /* ───────── LAYOUT ───────── */
  .app-body { display: flex; flex: 1; overflow: hidden; }

  /* ───────── SIDEBAR ───────── */
  .sidebar {
    width: 220px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    padding: 16px 0; flex-shrink: 0;
  }
  .sidebar-section { padding: 0 12px; margin-bottom: 20px; }
  .sidebar-label {
    font-size: 10px; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; color: var(--text-dim);
    padding: 0 8px; margin-bottom: 6px;
    font-family: 'Montserrat', sans-serif;
  }
  .sidebar-item {
    display: flex; align-items: center; gap: 9px;
    padding: 8px 10px; border-radius: var(--radius-sm);
    cursor: pointer; font-size: 13.5px;
    color: var(--text-muted); transition: all 0.15s; position: relative;
  }
  .sidebar-item:hover { color: var(--text); background: var(--surface2); }
  .sidebar-item.active { color: var(--blue-light); background: var(--blue-dim); }
  .sidebar-item .icon { font-size: 15px; width: 18px; text-align: center; }
  .sidebar-badge {
    margin-left: auto; background: var(--red);
    color: white; font-size: 10px; font-weight: 700;
    padding: 1px 6px; border-radius: 20px;
    font-family: 'Montserrat', sans-serif;
  }
  .sidebar-badge.gold { background: var(--blue); color: #ffffff; }
  .platform-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .sidebar-divider { height: 1px; background: var(--border); margin: 4px 12px 16px; }

  .stats-widget { margin: 0 12px; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; }
  .stats-title { font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 12px; font-family: 'Montserrat', sans-serif; }
  .stat-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .stat-label { font-size: 12px; color: var(--text-muted); }
  .stat-val { font-size: 14px; font-weight: 700; color: var(--text); font-family: 'Montserrat', sans-serif; }
  .stat-val.gold { color: var(--blue-light); }
  .stat-bar { height: 3px; background: var(--border); border-radius: 2px; margin-bottom: 10px; overflow: hidden; }
  .stat-bar-fill { height: 100%; background: var(--blue); border-radius: 2px; transition: width 0.5s; }

  /* ───────── MAIN ───────── */
  .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative; }

  .toolbar {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 20px; border-bottom: 1px solid var(--border); flex-shrink: 0;
  }
  .search-box {
    display: flex; align-items: center; gap: 8px;
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 7px 12px;
    flex: 1; max-width: 320px;
  }
  .search-box input { background: none; border: none; outline: none; color: var(--text); font-size: 13px; font-family: 'Barlow', sans-serif; width: 100%; }
  .search-box input::placeholder { color: var(--text-dim); }
  .filter-chip {
    padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;
    cursor: pointer; border: 1px solid var(--border); color: var(--text-muted);
    background: transparent; transition: all 0.15s; white-space: nowrap;
  }
  .filter-chip:hover { border-color: var(--text-dim); color: var(--text); }
  .filter-chip.active { border-color: var(--blue); color: var(--blue-light); background: var(--blue-dim); }
  .toolbar-right { margin-left: auto; display: flex; gap: 8px; }
  .view-toggle { display: flex; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
  .view-btn { padding: 6px 12px; cursor: pointer; font-size: 15px; color: var(--text-muted); border: none; background: none; transition: all 0.15s; }
  .view-btn:hover { color: var(--text); }
  .view-btn.active { background: var(--surface3); color: var(--blue-light); }

  /* ───────── KANBAN ───────── */
  .kanban-wrapper { flex: 1; overflow-x: auto; overflow-y: hidden; padding: 20px; display: flex; gap: 14px; align-items: flex-start; }
  .kanban-col { width: 260px; flex-shrink: 0; display: flex; flex-direction: column; max-height: 100%; }
  .col-header {
    display: flex; align-items: center; gap: 8px; padding: 10px 12px;
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: var(--radius) var(--radius) 0 0; border-bottom: none;
  }
  .col-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .col-title { font-size: 12px; font-weight: 600; font-family: 'Montserrat', sans-serif; letter-spacing: 0.5px; text-transform: uppercase; color: var(--text-muted); flex: 1; }
  .col-count { font-size: 11px; font-weight: 700; color: var(--text-dim); background: var(--surface3); padding: 1px 7px; border-radius: 10px; font-family: 'Montserrat', sans-serif; }
  .col-body {
    background: var(--surface); border: 1px solid var(--border);
    border-top: none; border-radius: 0 0 var(--radius) var(--radius);
    padding: 10px 8px; display: flex; flex-direction: column; gap: 8px;
    overflow-y: auto; max-height: calc(100vh - 220px);
    transition: background 0.15s, border-color 0.15s;
  }
  .col-body.drag-over {
    background: rgba(30, 107, 235, 0.12);
    border-color: var(--blue);
    border-top: 2px solid var(--blue);
  }
  /* Card while being touch-dragged */
  .lead-card.touch-dragging { opacity: 0.3; transform: scale(0.97); }
  /* Floating clone during drag */
  .touch-drag-clone {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.92;
    transform: scale(1.04) rotate(1.5deg);
    box-shadow: 0 12px 32px rgba(0,0,0,0.65);
    border-radius: 10px;
    transition: none !important;
  }

  /* LEAD CARD */
  .lead-card {
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 12px; cursor: pointer;
    transition: all 0.15s; position: relative;
  }
  .lead-card:hover { border-color: rgba(27,106,235,0.5); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(27,106,235,0.15); }
  .lead-card.selected { border-color: var(--blue); background: rgba(27,106,235,0.06); }
  .lead-card-top { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; }
  .lead-avatar { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; font-family: 'Montserrat', sans-serif; flex-shrink: 0; color: #ffffff; }
  .lead-info { flex: 1; min-width: 0; }
  .lead-name { font-size: 13px; font-weight: 600; font-family: 'Montserrat', sans-serif; color: var(--text); margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lead-handle { font-size: 11px; color: var(--text-muted); }
  .platform-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 10px; font-family: 'Montserrat', sans-serif; letter-spacing: 0.3px; }
  .lead-preview { font-size: 12px; color: var(--text-muted); line-height: 1.4; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lead-card-footer { display: flex; align-items: center; justify-content: space-between; }
  .lead-time { font-size: 11px; color: var(--text-dim); }
  .lead-seller { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--text-muted); }
  .seller-dot { width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 700; font-family: 'Montserrat', sans-serif; color: #ffffff; }
  .unread-dot { position: absolute; top: 10px; right: 10px; width: 7px; height: 7px; border-radius: 50%; background: var(--blue-light); }
  .card-del-btn { position: absolute; top: 6px; right: 6px; width: 20px; height: 20px; border-radius: 50%; background: rgba(224,92,92,0.85); color: #fff; border: none; cursor: pointer; font-size: 11px; display: none; align-items: center; justify-content: center; z-index: 5; padding: 0; line-height: 1; }
  .lead-card:hover .card-del-btn { display: flex; }
  @keyframes notifSlideIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .add-card-btn { margin-top: 4px; padding: 8px; border-radius: var(--radius-sm); border: 1px dashed var(--border); color: var(--text-dim); font-size: 12px; cursor: pointer; text-align: center; transition: all 0.15s; background: transparent; width: 100%; }
  .add-card-btn:hover { border-color: var(--blue); color: var(--blue-light); }
  .empty-col { text-align: center; padding: 20px 10px; color: var(--text-dim); font-size: 12px; }

  /* ───────── LIST VIEW ───────── */
  .list-wrapper { flex: 1; overflow-y: auto; padding: 16px 20px; display: none; min-height: 0; }
  table { width: 100%; border-collapse: collapse; }
  thead th { text-align: left; font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); font-family: 'Montserrat', sans-serif; padding: 8px 12px; border-bottom: 1px solid var(--border); cursor: pointer; white-space: nowrap; }
  thead th:hover { color: var(--text-muted); }
  tbody tr { border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.1s; }
  tbody tr:hover { background: var(--surface2); }
  tbody tr.selected { background: rgba(27,106,235,0.06); }
  tbody td { padding: 11px 12px; font-size: 13px; vertical-align: middle; }
  .td-name { font-weight: 600; color: var(--text); font-family: 'Montserrat', sans-serif; }
  .td-sub { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
  .status-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 20px; font-family: 'Montserrat', sans-serif; white-space: nowrap; }

  /* ───────── DETAIL PANEL ───────── */
  .detail-panel { width: 380px; flex-shrink: 0; background: var(--surface); border-left: 1px solid var(--border); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.25s ease; position: relative; }
  .detail-panel.open { transform: translateX(0); }
  .detail-header { padding: 16px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .detail-close { position: absolute; top: 14px; right: 14px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); cursor: pointer; color: var(--text-muted); background: var(--surface2); font-size: 16px; border: none; transition: all 0.15s; }
  .detail-close:hover { color: var(--text); background: var(--surface3); }
  .detail-lead-info { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .detail-avatar { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 16px; font-family: 'Montserrat', sans-serif; flex-shrink: 0; color: #ffffff; }
  .detail-name { font-size: 16px; font-weight: 700; font-family: 'Montserrat', sans-serif; margin-bottom: 3px; }
  .detail-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .detail-tabs { display: flex; padding: 0 16px; border-bottom: 1px solid var(--border); flex-shrink: 0; background: var(--surface); }
  .detail-tab { padding: 10px 14px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-muted); border-bottom: 2px solid transparent; transition: all 0.15s; font-family: 'Montserrat', sans-serif; letter-spacing: 0.3px; white-space: nowrap; }
  .detail-tab:hover { color: var(--text); }
  .detail-tab.active { color: var(--blue-light); border-bottom-color: var(--blue); }
  .detail-body { flex: 1; overflow-y: auto; padding: 16px; }

  /* ── WhatsApp HEADER ── */
  .wa-header { display: none; align-items: center; gap: 10px; padding: 8px 12px; background: #1f2c34; flex-shrink: 0; min-height: 58px; }
  .wa-back { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #aebac1; cursor: pointer; flex-shrink: 0; border: none; background: none; padding: 0; }
  .wa-avatar { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; font-family: 'Montserrat', sans-serif; flex-shrink: 0; color: #fff; }
  .wa-info { flex: 1; min-width: 0; }
  .wa-name { font-size: 15px; font-weight: 600; color: #e9edef; font-family: 'Montserrat', sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wa-sub { font-size: 12px; color: #aebac1; display: flex; align-items: center; gap: 6px; margin-top: 1px; }
  .wa-plat-badge { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; padding: 1px 8px; border-radius: 10px; color: #fff; }

  /* MESSAGES */
  .messages-list { display: flex; flex-direction: column; gap: 2px; }
  .msg { display: flex; gap: 6px; align-items: flex-end; margin-bottom: 2px; }
  .msg.outgoing { flex-direction: row-reverse; }
  .msg.group-start { margin-top: 8px; }
  .msg-avatar { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 700; font-family: 'Montserrat', sans-serif; flex-shrink: 0; color: #ffffff; }
  .msg-avatar.hidden { visibility: hidden; }

  /* Bubble */
  .msg-bubble {
    max-width: 78%;
    padding: 7px 11px 5px;
    border-radius: 7.5px;
    font-size: 13.5px;
    line-height: 1.45;
    position: relative;
    word-break: break-word;
  }
  /* Incoming: dark gray #202c33, tail on left */
  .msg.incoming .msg-bubble {
    background: #202c33;
    color: #e9edef;
    border-top-left-radius: 0;
  }
  /* Outgoing: WhatsApp green #005c4b, tail on right */
  .msg.outgoing .msg-bubble {
    background: #005c4b;
    color: #e9edef;
    border-top-right-radius: 0;
  }
  .msg-time {
    font-size: 10px;
    color: rgba(233,237,239,0.6);
    margin-top: 3px;
    text-align: right;
    display: block;
  }
  .msg.incoming .msg-time { text-align: left; }
  .msg-wrap { display: flex; flex-direction: column; }

  /* WA Input bar */
  .msg-input-area {
    padding: 8px 10px;
    background: #1f2c34;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
    border-top: none;
  }
  .msg-input {
    flex: 1;
    background: #2a3942;
    border: none;
    border-radius: 24px;
    padding: 10px 16px;
    color: #e9edef;
    font-size: 14px;
    font-family: 'Barlow', sans-serif;
    outline: none;
    resize: none;
    line-height: 1.4;
  }
  .msg-input::placeholder { color: #8696a0; }
  .msg-input:focus { background: #2a3942; }
  .msg-send {
    width: 44px; height: 44px;
    background: #00a884;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .msg-send:hover { background: #06cf9c; }
  .wa-chat-bg {
    flex: 1;
    overflow-y: auto;
    padding: 8px 12px;
    background-color: #0b1218;
  }

  /* WA action icon buttons */
  .wa-btn-icon {
    width: 36px; height: 36px;
    background: none; border: none;
    color: #8696a0; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; border-radius: 50%;
    transition: color 0.15s, background 0.15s;
    padding: 0;
  }
  .wa-btn-icon:hover { color: #e9edef; background: rgba(255,255,255,0.08); }
  .wa-btn-icon.recording { color: #ef4444; animation: pulse 1s infinite; }
  @keyframes pulse { 0%,100% { opacity:1 } 50% { opacity:0.4 } }

  /* Media preview in bubbles */
  .msg-img { max-width: 100%; border-radius: 6px; display: block; margin-bottom: 4px; cursor: pointer; }
  .msg-file { display: flex; align-items: center; gap: 8px; padding: 4px 0; }
  .msg-audio { width: 100%; min-width: 180px; accent-color: #00a884; }

  /* Voice recording indicator */
  .recording-bar {
    display: none; align-items: center; gap: 10px;
    padding: 8px 14px; background: #1f2c34;
    color: #e9edef; font-size: 13px; flex: 1;
    border-radius: 24px;
  }
  .recording-bar.active { display: flex; }
  .rec-dot { width: 8px; height: 8px; border-radius: 50%; background: #ef4444; animation: pulse 1s infinite; flex-shrink: 0; }

  /* NOTES */
  .notes-list { display: flex; flex-direction: column; gap: 10px; }
  .note-card { background: var(--surface2); border: 1px solid var(--border); border-left: 3px solid var(--blue); border-radius: var(--radius-sm); padding: 11px 12px; }
  .note-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .note-author { font-size: 11px; font-weight: 600; color: var(--blue-light); font-family: 'Montserrat', sans-serif; }
  .note-date { font-size: 11px; color: var(--text-dim); }
  .note-text { font-size: 13px; line-height: 1.45; color: var(--text-muted); }
  .add-note-area { margin-top: 14px; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; }
  .add-note-area textarea { width: 100%; background: none; border: none; outline: none; color: var(--text); font-size: 13px; font-family: 'Barlow', sans-serif; resize: none; min-height: 64px; line-height: 1.5; }
  .add-note-area textarea::placeholder { color: var(--text-dim); }
  .add-note-footer { display: flex; justify-content: flex-end; margin-top: 8px; }

  /* INFO TAB */
  .info-grid { display: flex; flex-direction: column; gap: 2px; }
  .info-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); gap: 12px; }
  .info-row:last-child { border-bottom: none; }
  .info-label { font-size: 11px; font-weight: 600; color: var(--text-dim); font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 0.8px; width: 100px; flex-shrink: 0; }
  .info-val { font-size: 13px; color: var(--text); flex: 1; }
  .info-val select, .info-val input { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 13px; font-family: 'Barlow', sans-serif; padding: 5px 10px; outline: none; width: 100%; }
  .stage-selector { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }
  .stage-option { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); cursor: pointer; transition: all 0.15s; font-size: 13px; color: var(--text-muted); }
  .stage-option:hover { border-color: var(--text-dim); color: var(--text); }
  .stage-option.active { border-color: var(--blue); background: var(--blue-dim); color: var(--text); }
  .stage-option .stage-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

  /* ───────── MODAL ───────── */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 1000; display: none; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); width: 480px; max-width: 90vw; box-shadow: var(--shadow); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border); }
  .modal-title { font-size: 15px; font-weight: 700; font-family: 'Montserrat', sans-serif; color: var(--text); }
  .modal-body { padding: 20px; }
  .form-group { margin-bottom: 16px; }
  .form-label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); margin-bottom: 6px; font-family: 'Montserrat', sans-serif; }
  .form-input, .form-select, .form-textarea { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 13.5px; font-family: 'Barlow', sans-serif; padding: 9px 12px; outline: none; transition: border-color 0.15s; }
  .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--blue-border); }
  .form-textarea { resize: vertical; min-height: 80px; }
  .modal-footer { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }

  /* PLATFORM STYLES */
  .plat-ig { background: linear-gradient(135deg,#E1306C,#833AB4); color: white; }
  .plat-wa { background: rgba(37,211,102,0.15); color: #25D366; border: 1px solid rgba(37,211,102,0.3); }
  .plat-fb { background: rgba(24,119,242,0.15); color: #1877F2; border: 1px solid rgba(24,119,242,0.3); }
  .plat-tt { background: rgba(255,255,255,0.08); color: #F0EDE8; border: 1px solid rgba(255,255,255,0.15); }
  .dot-ig { background: #E1306C; }
  .dot-wa { background: #25D366; }
  .dot-fb { background: #1877F2; }
  .dot-tt { background: #888; }

  /* STATUS */
  .status-bot { background: rgba(139,92,246,0.12); color: #A78BFA; border: 1px solid rgba(139,92,246,0.3); }
  .status-nuevo { background: rgba(96,165,250,0.12); color: #60A5FA; border: 1px solid rgba(96,165,250,0.25); }
  .status-contacto { background: rgba(27,106,235,0.12); color: #3D85F5; border: 1px solid rgba(27,106,235,0.3); }
  .status-cotizacion { background: rgba(129,140,248,0.12); color: #818CF8; border: 1px solid rgba(129,140,248,0.25); }
  .status-negociacion { background: rgba(245,158,11,0.12); color: #F59E0B; border: 1px solid rgba(245,158,11,0.25); }
  .status-seguimiento { background: rgba(251,146,60,0.12); color: #FB923C; border: 1px solid rgba(251,146,60,0.3); }
  .status-ganado { background: rgba(76,175,136,0.12); color: #4CAF88; border: 1px solid rgba(76,175,136,0.25); }
  .status-perdido { background: rgba(224,92,92,0.12); color: #E05C5C; border: 1px solid rgba(224,92,92,0.25); }

  /* COLUMN DOTS */
  .col-dot-bot { background: #A78BFA; }
  .col-dot-nuevo { background: #60A5FA; }
  .col-dot-contacto { background: #1B6AEB; }
  .col-dot-cotizacion { background: #818CF8; }
  .col-dot-negociacion { background: #F59E0B; }
  .col-dot-seguimiento { background: #FB923C; }
  .col-dot-ganado { background: #4CAF88; }
  .col-dot-perdido { background: #E05C5C; }

  /* SELLERS */
  .seller-a { background: #1B6AEB; }
  .seller-b { background: #0EA5E9; }
  .seller-c { background: #4CAF88; }

  /* AVATARS */
  .av-1 { background: #1B6AEB; }
  .av-2 { background: #2563EB; }
  .av-3 { background: #1D4ED8; }
  .av-4 { background: #0EA5E9; }
  .av-5 { background: #6366F1; }
  .av-6 { background: #0284C7; }

  /* PIPELINE BAR */
  .pipeline-micro { display: flex; gap: 2px; height: 4px; width: 80px; }
  .pipeline-seg { flex: 1; border-radius: 2px; background: var(--border); }
  .pipeline-seg.filled { background: var(--blue); }

  /* TOAST */
  .toast { position: fixed; bottom: 20px; right: 20px; background: var(--surface2); border: 1px solid var(--border); border-left: 3px solid var(--blue); border-radius: var(--radius); padding: 12px 16px; font-size: 13px; color: var(--text); z-index: 9999; transform: translateY(80px); opacity: 0; transition: all 0.3s; max-width: 280px; }
  .toast.show { transform: translateY(0); opacity: 1; }

  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--text-dim); }

  /* ───────── MOBILE NAV (hidden on desktop) ───────── */
  .mobile-nav { display: none; }
  .mob-back-btn { display: none; }

  /* ───────── MOBILE RESPONSIVE ───────── */
  @media (max-width: 768px) {
    body { overflow: auto; }

    /* Header */
    header { padding: 0 12px; height: 50px; }
    .nav-tabs { display: none; }
    .header-right .btn-ghost { display: none; }
    .header-right { gap: 8px; }
    .logo-sub { display: none; }
    .logo-text { font-size: 13px; }

    /* Layout */
    .app-body { flex-direction: column; overflow: visible; padding-bottom: 60px; }
    .sidebar { display: none; }
    .main { width: 100%; flex: 1; overflow: visible; }

    /* Toolbar */
    .toolbar { padding: 8px 12px; gap: 8px; flex-wrap: nowrap; }
    .search-box { max-width: 100%; flex: 1; }
    .view-toggle { display: flex; }
    .filter-chip { display: none; }
    #lead-count { font-size: 11px; white-space: nowrap; }

    /* Kanban: horizontal scroll on mobile */
    .kanban-wrapper {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      padding: 10px 12px 80px;
      display: flex;
      gap: 12px;
      flex-wrap: nowrap;
      align-items: flex-start;
    }
    .kanban-col { min-width: 270px; max-width: 270px; flex-shrink: 0; }
    .list-wrapper { padding: 10px 12px 80px; }

    /* Convert table to card list on mobile */
    table { display: block; }
    thead { display: none; }
    tbody { display: flex; flex-direction: column; gap: 8px; }
    tbody tr {
      display: flex; align-items: center; gap: 10px;
      background: var(--surface2);
      border: 1px solid var(--border) !important;
      border-bottom: 1px solid var(--border) !important;
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      cursor: pointer;
    }
    tbody tr:hover { background: var(--surface3); }
    tbody td { padding: 0; border: none; }
    /* Hide less important columns on mobile */
    tbody td:nth-child(3),
    tbody td:nth-child(4),
    tbody td:nth-child(5),
    tbody td:nth-child(6) { display: none; }
    tbody td:first-child { flex: 1; min-width: 0; }
    tbody td:nth-child(2) { flex-shrink: 0; }

    /* Detail panel: full-screen slide from RIGHT (WhatsApp style) */
    .detail-panel {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      height: 100dvh !important;        /* shrinks when keyboard appears */
      transform: translateX(100%) !important;
      z-index: 600;
      border-left: none !important;
      display: flex !important;
      flex-direction: column !important;
      background: #0b1218 !important;
      overflow: hidden !important;
    }
    .detail-panel.open { transform: translateX(0) !important; }
    /* Message area fills the space between header+tabs and input */
    .detail-panel .detail-body {
      flex: 1 !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch !important;
      min-height: 0 !important;
    }
    /* Input bar stays at the bottom, above keyboard */
    .detail-panel #detail-footer { flex-shrink: 0 !important; }

    /* WA header overrides on mobile */
    .detail-header { padding: 0 !important; border-bottom: none !important; }
    .wa-header { display: flex !important; }
    .detail-close { display: none !important; }
    .mob-back-btn { display: none !important; }

    /* Detail tabs on mobile: compact */
    .detail-tabs { background: #1f2c34 !important; border-bottom-color: #2a3942 !important; }
    .detail-tab { font-size: 11px !important; padding: 9px 10px !important; }
    .detail-body { background: #0b1218; padding: 8px 10px !important; }

    /* WA bubble bg on mobile */
    .wa-chat-bg { background-image: none !important; background-color: #0b1218 !important; }

    /* Settings full width */
    #settings-view > div { padding: 12px !important; max-width: 100% !important; }

    /* Message input: safe area */
    .msg-input-area {
      padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    }

    /* Modal */
    .modal { width: 95vw !important; }

    /* Login */
    .login-box { width: 92vw; padding: 24px 18px; }

    /* Bottom mobile nav */
    .mobile-nav {
      display: flex;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 58px;
      background: var(--surface);
      border-top: 1px solid var(--border);
      z-index: 500;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .mob-tab {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 3px;
      cursor: pointer; color: var(--text-muted);
      font-size: 10px; font-weight: 600;
      font-family: 'Montserrat', sans-serif;
      transition: color 0.15s; border: none; background: none;
      padding: 0; position: relative;
    }
    .mob-tab.active { color: var(--blue-light); }
    .mob-tab .mob-icon { font-size: 21px; line-height: 1; }
    .mob-tab .mob-badge {
      position: absolute; top: 3px; right: calc(50% - 20px);
      background: var(--red); color: #fff;
      font-size: 9px; font-weight: 700;
      padding: 1px 4px; border-radius: 8px; min-width: 14px; text-align: center;
      font-family: 'Montserrat', sans-serif;
    }
    /* "+" central button */
    .mob-tab.mob-add .mob-icon {
      font-size: 28px;
      color: var(--blue-light);
      line-height: 1;
    }
    .mob-tab.mob-add { color: var(--blue-light); }

    /* Toast higher on mobile so it clears the bottom nav */
    .toast { bottom: 72px; }

    /* Back button visible, close btn hidden on mobile */
    .mob-back-btn { display: flex !important; }
    .detail-close { display: none; }
  }
</style>
</head>
<body>

<!-- LOADING -->
<div class="loading-overlay" id="loading-overlay">
  <div class="loading-logo">
    <div class="logo-mark">KD</div>
    <div>
      <div class="logo-text">KERSA <span>DESIGN</span></div>
      <span class="logo-sub">CRM Social</span>
    </div>
  </div>
  <div class="loading-dots">
    <div class="loading-dot"></div>
    <div class="loading-dot"></div>
    <div class="loading-dot"></div>
  </div>
  <div class="loading-text">Cargando...</div>
</div>

<!-- CONFIG MISSING -->
<div class="config-overlay" id="config-overlay">
  <div class="config-box">
    <div class="login-logo" style="margin-bottom:20px">
      <div class="logo-mark">KD</div>
      <div>
        <div class="logo-text">KERSA <span>DESIGN</span></div>
        <span class="logo-sub">CRM Social</span>
      </div>
    </div>
    <div style="font-size:18px;font-weight:700;font-family:Montserrat,sans-serif;margin-bottom:8px">Configura tu base de datos</div>
    <div style="font-size:13px;color:var(--text-muted);margin-bottom:24px">Sigue estos 3 pasos para conectar el CRM a Supabase (gratis)</div>

    <div class="config-step">
      <div class="config-num">1</div>
      <div>
        <div class="config-step-title">Crea tu proyecto</div>
        <div class="config-step-desc">Ve a <span class="config-url">supabase.com</span> → Sign up gratis → New Project → ponle nombre "kersa-crm"</div>
      </div>
    </div>
    <div class="config-step">
      <div class="config-num">2</div>
      <div>
        <div class="config-step-title">Crea las tablas</div>
        <div class="config-step-desc">En Supabase: <span class="config-url">SQL Editor → New Query</span> → pega y ejecuta el archivo <strong>supabase-schema.sql</strong></div>
      </div>
    </div>
    <div class="config-step">
      <div class="config-num">3</div>
      <div>
        <div class="config-step-title">Pega tus claves aquí</div>
        <div class="config-step-desc">En Supabase: <span class="config-url">Settings → API</span> → copia Project URL y anon key, y pégalas en este archivo al principio del script</div>
      </div>
    </div>
    <div style="font-size:12px;color:var(--text-dim);margin-top:12px;text-align:center">Luego recarga esta página y estarás listo 🚀</div>
  </div>
</div>

<!-- LOGIN -->
<div class="login-overlay hidden" id="login-overlay">
  <div class="login-box">
    <div class="login-logo">
      <div class="logo-mark">KD</div>
      <div>
        <div class="logo-text">KERSA <span>DESIGN</span></div>
        <span class="logo-sub">CRM Social</span>
      </div>
    </div>
    <div class="login-title">Bienvenida al equipo</div>
    <div class="login-sub">Ingresa con tu cuenta de trabajo</div>
    <div class="form-group">
      <label class="form-label">Correo electrónico</label>
      <input type="email" class="form-input" id="login-email" placeholder="tu@kersa.com" onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <div class="form-group">
      <label class="form-label">Contraseña</label>
      <input type="password" class="form-input" id="login-password" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <div class="login-error" id="login-error"></div>
    <div class="login-spinner" id="login-spinner">Ingresando...</div>
    <button class="btn-primary" id="login-btn" style="width:100%;padding:11px;font-size:14px;margin-top:4px" onclick="doLogin()">Entrar →</button>
  </div>
</div>

<!-- HEADER -->
<header>
  <div class="logo">
    <div class="logo-mark">KD</div>
    <div>
      <div class="logo-text">KERSA <span>DESIGN</span></div>
      <span class="logo-sub">CRM Social</span>
    </div>
  </div>
  <div class="nav-tabs">
    <div class="nav-tab active" onclick="switchView('kanban',this)">🗂 Embudo</div>
    <div class="nav-tab" onclick="switchView('list',this)">☰ Leads</div>
    <div class="nav-tab" onclick="switchView('metrics',this)">📊 Reportes</div>
    <div class="nav-tab" onclick="showToast('🤖 Agente IA en desarrollo')">🤖 Agente IA</div>
    <div class="nav-tab" onclick="switchView('settings',this)">⚙️ Ajustes</div>
  </div>
  <div class="header-right">
    <button class="btn-ghost" onclick="showToast('📥 Importación próximamente')">Importar</button>
    <button class="btn-primary" onclick="openNewLeadModal()">+ Nuevo lead</button>
    <div class="user-chip" onclick="doLogout()" title="Cerrar sesión">
      <div class="avatar" id="user-avatar">JM</div>
      <span class="user-name" id="user-name">Jose Manuel</span>
    </div>
  </div>
</header>

<!-- APP BODY -->
<div class="app-body">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-label">Bandeja</div>
      <div class="sidebar-item active" onclick="filterBy('all',this)">
        <span class="icon">📥</span> Todos los leads
        <span class="sidebar-badge gold" id="badge-all">0</span>
      </div>
      <div class="sidebar-item" onclick="filterBy('unread',this)">
        <span class="icon">🔔</span> Sin responder
        <span class="sidebar-badge" id="badge-unread" style="display:none">0</span>
      </div>
      <div class="sidebar-item" onclick="filterBy('mine',this)">
        <span class="icon">👤</span> Mis leads
      </div>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
      <div class="sidebar-label">Plataforma</div>
      <div class="sidebar-item" onclick="filterBy('Instagram',this)"><div class="platform-dot dot-ig"></div>Instagram</div>
      <div class="sidebar-item" onclick="filterBy('WhatsApp',this)"><div class="platform-dot dot-wa"></div>WhatsApp</div>
      <div class="sidebar-item" onclick="filterBy('Facebook',this)"><div class="platform-dot dot-fb"></div>Facebook</div>
      <div class="sidebar-item" onclick="filterBy('TikTok',this)"><div class="platform-dot dot-tt"></div>TikTok</div>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
      <div id="sellers-sidebar"></div>
    </div>
    <div style="flex:1"></div>
    <div class="stats-widget">
      <div class="stats-title">Este mes</div>
      <div class="stat-row"><span class="stat-label">Leads nuevos</span><span class="stat-val" id="stat-total">0</span></div>
      <div class="stat-row"><span class="stat-label">Convertidos</span><span class="stat-val gold" id="stat-won">0</span></div>
      <div class="stat-bar"><div class="stat-bar-fill" id="stat-bar" style="width:0%"></div></div>
      <div class="stat-row"><span class="stat-label">Conversión</span><span class="stat-val" id="stat-pct">0%</span></div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <div class="toolbar">
      <div class="search-box">
        <span style="color:var(--text-dim)">🔍</span>
        <input type="text" placeholder="Buscar lead, nombre, mensaje..." id="search-input" oninput="filterSearch()">
      </div>
      <div class="view-toggle">
        <button class="view-btn active" id="view-kanban-btn" onclick="switchView('kanban',null)" title="Kanban">⊞</button>
        <button class="view-btn" id="view-list-btn" onclick="switchView('list',null)" title="Lista">☰</button>
      </div>
      <span style="color:var(--text-dim);font-size:12px;margin-left:4px" id="lead-count">0 leads</span>
    </div>
    <div class="kanban-wrapper" id="kanban-view"></div>
    <div class="list-wrapper" id="list-view">
      <table>
        <thead><tr>
          <th>Lead</th><th>Plataforma</th><th>Estado</th><th>Vendedora</th><th>Último contacto</th><th>Pipeline</th>
        </tr></thead>
        <tbody id="list-tbody"></tbody>
      </table>
    </div>

    <!-- METRICS VIEW -->
    <div id="metrics-view" style="display:none"></div>

    <!-- SETTINGS VIEW -->
    <div id="settings-view" style="display:none">
      <div style="max-width:700px;margin:0 auto">
      <h2 style="font-family:Montserrat,sans-serif;font-size:18px;font-weight:700;margin-bottom:24px;color:var(--text)">⚙️ Configuración</h2>

      <!-- WhatsApp QR Card -->
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:20px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="width:40px;height:40px;background:linear-gradient(135deg,#25d366,#128c7e);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px">💬</div>
          <div>
            <div style="font-family:Montserrat,sans-serif;font-weight:700;font-size:14px;color:var(--text)">WhatsApp — Kersa Principal</div>
            <div style="font-size:12px;color:var(--text-muted)">Conecta tu número escaneando el QR con WhatsApp</div>
          </div>
          <div style="margin-left:auto">
            <span id="wa-status-badge" style="font-size:11px;font-weight:600;padding:4px 10px;border-radius:20px;background:var(--surface2);color:var(--text-muted)">Verificando...</span>
          </div>
        </div>

        <div id="wa-qr-section" style="display:none;text-align:center;padding:16px 0">
          <p style="font-size:12px;color:var(--text-muted);margin-bottom:12px">Abre WhatsApp → <strong>Dispositivos vinculados</strong> → <strong>Vincular dispositivo</strong></p>
          <div style="display:inline-block;background:white;padding:12px;border-radius:8px">
            <img id="wa-qr-img" src="" alt="QR WhatsApp" style="width:220px;height:220px;display:block">
          </div>
          <p style="font-size:11px;color:var(--text-dim);margin-top:10px">El QR expira en 60 segundos. <a href="#" onclick="loadWaQR()" style="color:var(--blue-light)">Renovar</a></p>
        </div>

        <div id="wa-connected-section" style="display:none;padding:12px 0">
          <div style="display:flex;align-items:center;gap:10px;padding:12px;background:rgba(37,211,102,0.08);border:1px solid rgba(37,211,102,0.3);border-radius:8px">
            <span style="font-size:18px">✅</span>
            <div>
              <div style="font-size:13px;font-weight:600;color:#25d366">WhatsApp conectado</div>
              <div id="wa-phone-label" style="font-size:12px;color:var(--text-muted)">Número activo</div>
            </div>
            <button onclick="disconnectWa()" style="margin-left:auto;font-size:11px;padding:6px 12px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--text-muted);cursor:pointer">Desconectar</button>
          </div>
        </div>

        <div id="wa-loading-section" style="text-align:center;padding:16px 0">
          <div style="font-size:13px;color:var(--text-muted)">Cargando estado...</div>
        </div>

        <div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">
          <button onclick="loadWaStatus()" style="font-size:12px;padding:8px 16px;border:1px solid var(--border);border-radius:6px;background:var(--surface2);color:var(--text);cursor:pointer">🔄 Actualizar estado</button>
          <button onclick="loadWaQR()" id="btn-get-qr" style="font-size:12px;padding:8px 16px;border:1px solid var(--blue-border);border-radius:6px;background:var(--blue-dim);color:var(--blue-light);cursor:pointer">📷 Obtener QR</button>
        </div>
      </div>

      <!-- Info integrations -->
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px">
        <div style="font-family:Montserrat,sans-serif;font-weight:700;font-size:14px;color:var(--text);margin-bottom:16px">📡 Estado de integraciones</div>
        <div style="display:grid;gap:10px">
          <div style="display:flex;align-items:center;gap:12px;padding:10px;background:var(--surface2);border-radius:8px">
            <span style="font-size:18px">📸</span><div style="font-size:13px;color:var(--text)">Instagram DMs</div><span style="margin-left:auto;font-size:11px;padding:3px 8px;border-radius:10px;background:rgba(37,211,102,0.15);color:#25d366;font-weight:600">Conectado</span>
          </div>
          <div style="display:flex;align-items:center;gap:12px;padding:10px;background:var(--surface2);border-radius:8px">
            <span style="font-size:18px">👤</span><div style="font-size:13px;color:var(--text)">Facebook Messenger (Grupo Kersa)</div><span style="margin-left:auto;font-size:11px;padding:3px 8px;border-radius:10px;background:rgba(37,211,102,0.15);color:#25d366;font-weight:600">Conectado</span>
          </div>
          <div style="display:flex;align-items:center;gap:12px;padding:10px;background:var(--surface2);border-radius:8px">
            <span style="font-size:18px">💬</span><div style="font-size:13px;color:var(--text)">WhatsApp (Evolution API)</div><span id="wa-integ-status" style="margin-left:auto;font-size:11px;padding:3px 8px;border-radius:10px;background:rgba(255,180,0,0.15);color:#f5a623;font-weight:600">Pendiente QR</span>
          </div>
        </div>
      </div>

      <!-- Usuarios del CRM -->
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px;margin-top:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
          <div style="display:flex;align-items:center;gap:12px">
            <div style="width:40px;height:40px;background:linear-gradient(135deg,#7C3AED,#4F46E5);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px">👥</div>
            <div>
              <div style="font-family:Montserrat,sans-serif;font-weight:700;font-size:14px;color:var(--text)">Usuarios del CRM</div>
              <div style="font-size:12px;color:var(--text-muted)">Gestiona quién puede atender leads</div>
            </div>
          </div>
          <button onclick="showAddUserForm()" style="font-size:12px;padding:8px 14px;border-radius:6px;background:var(--blue);color:#fff;border:none;cursor:pointer;font-weight:600">+ Agregar</button>
        </div>
        <div id="users-list"></div>
        <div id="add-user-form" style="display:none;background:var(--surface2);border-radius:10px;padding:16px;margin-top:12px"></div>
      </div>

      <!-- Asignaciones -->
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px;margin-top:20px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
          <div style="width:40px;height:40px;background:linear-gradient(135deg,#F59E0B,#EF4444);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px">🎯</div>
          <div>
            <div style="font-family:Montserrat,sans-serif;font-weight:700;font-size:14px;color:var(--text)">Asignaciones de Leads</div>
            <div style="font-size:12px;color:var(--text-muted)">Define quién atiende según plataforma o por turno rotativo</div>
          </div>
        </div>
        <div id="assign-section"></div>
      </div>

      </div><!-- /max-width wrapper -->
